<Window x:Class="DentalClinic.NurseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DentalClinic.UI;assembly=DentalClinic.UI"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        Title="{DynamicResource App_NurseTitle}" Height="680" Width="1300" MinWidth="1040" MinHeight="500"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        ui:WindowFx.AnimateEntrance="True">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- زر طباعة الوصفة: أبيض/معطل بدون وصفة، وأخضر عند وجود دواء -->
        <Style x:Key="PrescriptionPrintButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPrescription}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي: إجراءات سريعة -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- زر فتح الملف الطبي - يظهر فقط لمن يملك صلاحية UserPermission.OpenPatientFile -->
                    <Button x:Name="OpenPatientFileButton" Content="{DynamicResource Main_OpenPatientFile}" Width="150" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Click="OpenPatientFileButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.RegisterPatients -->
                    <Button x:Name="RegisterPatientButton" Content="{DynamicResource Main_RegisterPatient}" Width="180" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Click="AddPatientButton_Click"/>
                    <Button Content="{DynamicResource Main_SearchPatient}" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SearchPatientButton_Click"/>
                    <!-- زر تحصيل الدفعات العلوي - يظهر فقط لمن يملك صلاحية UserPermission.CollectPayments -->
                    <Button x:Name="CollectPaymentTopButton" Content="{DynamicResource Main_CollectPayment}" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="CollectPaymentButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.ManageTreatments -->
                    <Button x:Name="ManageTreatmentsButton" Content="{DynamicResource Main_Treatments}" Width="120" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="ManageTreatmentsButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.AccessBackup -->
                    <Button x:Name="BackupButton" Content="{DynamicResource Main_Backup}" Width="100" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="BackupButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.ManageUsers -->
                    <Button x:Name="ManageUsersButton" Content="{DynamicResource Main_ManageUsers}" Width="140" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="ManageUsersButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.AccessFinance -->
                    <Button x:Name="FinancialDashboardButton" Content="{DynamicResource Main_Finances}" Width="110" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="FinancialDashboardButton_Click"/>
                </StackPanel>
                <Button Content="{DynamicResource Main_Logout}" DockPanel.Dock="Right" Width="90" Height="42"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click"/>
                <controls:ConnectionStatusIndicator x:Name="ConnectionStatusIndicatorControl" DockPanel.Dock="Right" Margin="0,0,14,0"/>
                <Button Content="{DynamicResource Main_Refresh}" DockPanel.Dock="Right" Width="90" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <!-- شريط اختيار "قائمة انتظار مين" - القيمة الافتراضية دائماً "غير مُسنَدين" (لا تحتاج أي صلاحية خاصة)،
             وبقية الخيارات هي الأطباء اللي منحها الطبيب الرئيسي صلاحية رؤية قوائمهم فقط (راجع UserEditWindow) -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSoftBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Main_ViewingQueueOf}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,10,0"/>
                <Border Style="{StaticResource InputContainerStyle}" Width="260">
                    <ComboBox x:Name="DoctorViewSelector" BorderThickness="0" Background="Transparent"
                              Padding="10,6" FontSize="13" VerticalContentAlignment="Center"
                              SelectionChanged="DoctorViewSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة قائمة الانتظار -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
            <DataGrid x:Name="QueueGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="QueueGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Main_ColPatientName}" Binding="{Binding PatientFullName}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource Main_ColCheckInTime}" Binding="{Binding CheckInTimeText}" Width="150" ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColStatus}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="12,4" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- العمود الخاص بالموعد القادم + زر تعديل (يحتاج موافقة الطبيب) -->
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColNextAppointment}" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NextAppointmentText}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <Button Content="{DynamicResource Main_EditAppointmentButton}" Height="24" Width="55" FontSize="10.5"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding HasNextAppointment, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding IsAppointmentEditable}"
                                            Tag="{Binding}" Click="EditAppointmentButton_Click"/>
                                    <TextBlock Text="{DynamicResource Main_AppointmentPending}" FontSize="10.5" FontStyle="Italic"
                                               Foreground="#B8860B" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding IsAppointmentPending, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- عمود الإجراءات ممتد ليشمل زر تسجيل الحضور والتحصيل والشارة والإلغاء -->
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColActions}" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Main_CheckIn}" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CheckInButton_Click"/>

                                    <!-- 1. زر الدفع المباشر (يظهر فقط إذا كان المريض مديوناً) -->
                                    <Button Content="{DynamicResource Main_Pay}" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding HasUnpaidBalance, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CollectPaymentButton_Click"/>

                                    <!-- 2. شارة "تم الدفع" الخضراء (تظهر عند سداد كامل المبلغ) -->
                                    <Border Background="#10B981" CornerRadius="6" Height="26" Width="65" Margin="0,0,6,0"
                                            Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{DynamicResource Main_AllSessionsPaidTooltip}">
                                        <TextBlock Text="{DynamicResource Main_Paid}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 4. زر إلغاء الزيارة -->
                                    <Button Content="{DynamicResource Main_Cancel}" Height="26" Width="65" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CancelVisitButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- عمود تعديل بيانات المريض - يُخفى بالكامل برمجياً في الكود الخلفي لمن لا يملك صلاحية EditPatients -->
                    <DataGridTemplateColumn x:Name="EditPatientColumn" Header="{DynamicResource Main_EditPatient}" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{DynamicResource Main_EditPatient}" Height="26" Width="60" FontSize="10.5" Margin="0,0,5,0"
                                            Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="EditPatientButton_Click"/>
                                    <Button Content="🖨" ToolTip="{DynamicResource Main_PrintPrescriptionTooltip}" Height="26" Width="32" FontSize="12"
                                            Style="{StaticResource PrescriptionPrintButtonStyle}" Tag="{Binding}" IsEnabled="{Binding HasPrescription}"
                                            Click="PrintPrescriptionButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- عمود حذف المريض نهائياً - يُخفى بالكامل برمجياً في الكود الخلفي لمن لا يملك صلاحية DeletePatients -->
                    <DataGridTemplateColumn x:Name="DeletePatientColumn" Header="{DynamicResource Main_DeletePatient}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Main_DeletePatient}" Height="26" Width="65" FontSize="11"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Tag="{Binding}" Click="DeletePatientButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- حالة فارغة أنيقة - تظهر فقط عندما لا يوجد أي مريض في قائمة الانتظار اليوم -->
            <StackPanel x:Name="EmptyQueuePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🦷" FontSize="42" HorizontalAlignment="Center" Opacity="0.35" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Main_EmptyQueue}" FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
