<Window x:Class="DentalClinic.NurseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        Title="{DynamicResource App_NurseTitle}" Height="680" Width="1300" MinWidth="1040" MinHeight="500"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي: إجراءات سريعة -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- زر فتح الملف الطبي - يظهر فقط لمن يملك صلاحية UserPermission.OpenPatientFile -->
                    <Button x:Name="OpenPatientFileButton" Content="{DynamicResource Main_OpenPatientFile}" Width="150" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Click="OpenPatientFileButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.RegisterPatients -->
                    <Button x:Name="RegisterPatientButton" Content="{DynamicResource Main_RegisterPatient}" Width="180" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Click="AddPatientButton_Click"/>
                    <Button Content="{DynamicResource Main_SearchPatient}" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SearchPatientButton_Click"/>
                    <!-- زر تحصيل الدفعات العلوي - يظهر فقط لمن يملك صلاحية UserPermission.CollectPayments -->
                    <Button x:Name="CollectPaymentTopButton" Content="{DynamicResource Main_CollectPayment}" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="CollectPaymentButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.ManageTreatments -->
                    <Button x:Name="ManageTreatmentsButton" Content="{DynamicResource Main_Treatments}" Width="120" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="ManageTreatmentsButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.AccessBackup -->
                    <Button x:Name="BackupButton" Content="{DynamicResource Main_Backup}" Width="100" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="BackupButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.ManageUsers -->
                    <Button x:Name="ManageUsersButton" Content="{DynamicResource Main_ManageUsers}" Width="140" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="ManageUsersButton_Click"/>
                    <!-- يظهر فقط لمن يملك صلاحية UserPermission.AccessFinance -->
                    <Button x:Name="FinancialDashboardButton" Content="{DynamicResource Main_Finances}" Width="110" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="FinancialDashboardButton_Click"/>
                </StackPanel>
                <Button Content="{DynamicResource Main_Logout}" DockPanel.Dock="Right" Width="90" Height="42"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click"/>
                <Button Content="{DynamicResource Main_Refresh}" DockPanel.Dock="Right" Width="90" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <!-- الشريط السفلي: عدد المرضى اليوم -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة قائمة الانتظار -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="QueueGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="QueueGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Main_ColPatientName}" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Main_ColCheckInTime}" Binding="{Binding CheckInTimeText}" Width="150"/>
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColStatus}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- العمود الخاص بالموعد القادم -->
                    <DataGridTextColumn Header="{DynamicResource Main_ColNextAppointment}" Binding="{Binding NextAppointmentText}" Width="160"/>

                    <!-- عمود الإجراءات ممتد ليشمل زر تسجيل الحضور والتحصيل والشارة والإلغاء -->
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColActions}" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- 0. زر تسجيل الحضور (يظهر فقط للمواعيد المحجوزة التي وصل يومها) -->
                                    <Button Content="{DynamicResource Main_CheckIn}" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CheckInButton_Click"/>

                                    <!-- 1. زر الدفع المباشر (يظهر فقط إذا كان المريض مديوناً) -->
                                    <Button Content="{DynamicResource Main_Pay}" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding HasUnpaidBalance, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CollectPaymentButton_Click"/>

                                    <!-- 2. شارة "تم الدفع" الخضراء (تظهر عند سداد كامل المبلغ) -->
                                    <Border Background="#10B981" CornerRadius="6" Height="26" Width="65" Margin="0,0,6,0"
                                            Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{DynamicResource Main_AllSessionsPaidTooltip}">
                                        <TextBlock Text="{DynamicResource Main_Paid}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 3. زر إلغاء الزيارة -->
                                    <Button Content="{DynamicResource Main_Cancel}" Height="26" Width="65" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CancelVisitButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
