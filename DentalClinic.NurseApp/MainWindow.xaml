<Window x:Class="DentalClinic.NurseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        Title="Reception App" Height="680" Width="1100" MinWidth="850" MinHeight="500"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي: إجراءات سريعة -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Register New Patient" Width="180" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddPatientButton_Click"/>
                    <Button Content="Search Patient" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SearchPatientButton_Click"/>
                    <!-- زر تحصيل الدفعات العلوي -->
                    <Button Content="Collect Payment" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Click="CollectPaymentButton_Click"/>
                </StackPanel>
                <Button Content="Logout" DockPanel.Dock="Right" Width="90" Height="42"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click"/>
                <Button Content="Refresh" DockPanel.Dock="Right" Width="90" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <!-- الشريط السفلي: عدد المرضى اليوم -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة قائمة الانتظار -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="QueueGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PATIENT NAME" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="CHECK-IN TIME" Binding="{Binding CheckInTimeText}" Width="150"/>
                    <DataGridTemplateColumn Header="STATUS" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusText, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- العمود الخاص بالموعد القادم -->
                    <DataGridTextColumn Header="NEXT APPOINTMENT" Binding="{Binding NextAppointmentText}" Width="160"/>

                    <!-- عمود الإجراءات ممتد ليشمل زر تسجيل الحضور والتحصيل والشارة والإلغاء -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- 0. زر تسجيل الحضور (يظهر فقط للمواعيد المحجوزة التي وصل يومها) -->
                                    <Button Content="Check-In" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CheckInButton_Click"/>

                                    <!-- 1. زر الدفع المباشر (يظهر فقط إذا كان المريض مديوناً) -->
                                    <Button Content="Pay" Height="26" Width="65" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding HasUnpaidBalance, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CollectPaymentButton_Click"/>

                                    <!-- 2. شارة "تم الدفع" الخضراء (تظهر عند سداد كامل المبلغ) -->
                                    <Border Background="#10B981" CornerRadius="6" Height="26" Width="65" Margin="0,0,6,0"
                                            Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}"
                                            ToolTip="All sessions paid in full">
                                        <TextBlock Text="Paid ✓" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 3. زر إلغاء الزيارة -->
                                    <Button Content="Cancel" Height="26" Width="65" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CancelVisitButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>