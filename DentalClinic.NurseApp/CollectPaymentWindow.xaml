<Window x:Class="DentalClinic.NurseApp.CollectPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collect Payment" Height="500" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F8FAFC">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="💳 Collect Payment" FontSize="18" FontWeight="Bold"
                   Foreground="#1E78AA" Margin="0,0,0,16"/>

        <!-- Financial Details -->
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="PatientNameText" Text="Patient: -" FontSize="15" FontWeight="SemiBold"
                       Foreground="#1E293B" Margin="0,0,0,14"/>

            <!-- Account Summary Card -->
            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Cost:" Foreground="#64748B" FontSize="13"/>
                    <TextBlock x:Name="TotalPriceText" Grid.Row="0" Grid.Column="1" Text="0 DA" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Already Paid:" Foreground="#64748B" FontSize="13" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AlreadyPaidText" Grid.Row="1" Grid.Column="1" Text="0 DA" FontWeight="Bold" Foreground="#16A34A" FontSize="13" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Remaining Balance:" Foreground="#64748B" FontSize="13" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RemainingText" Grid.Row="2" Grid.Column="1" Text="0 DA" FontWeight="Bold" Foreground="#DC2626" FontSize="13" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Input Fields -->
            <TextBlock Text="Amount Being Paid Now (DZD) *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="PaymentAmountBox" Height="38" FontSize="15" FontWeight="Bold" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Notes / Payment Method (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="NotesBox" Height="38" FontSize="13" Padding="8,6" Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0"
                    Click="CloseButton_Click"/>
            <Button x:Name="ConfirmPaymentButton" Content="Confirm Payment" Width="140" Height="36"
                    Background="#1E78AA" Foreground="White" FontWeight="Bold"
                    Click="ConfirmPaymentButton_Click"/>
        </StackPanel>
    </Grid>
</Window>