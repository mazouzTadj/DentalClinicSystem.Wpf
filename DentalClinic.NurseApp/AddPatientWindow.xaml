<Window x:Class="DentalClinic.NurseApp.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Patient" Height="640" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Register New Patient" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20">
                <StackPanel>

                    <TextBlock Text="Full Name *" Style="{StaticResource FieldLabelStyle}" Margin="4,10,0,4"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="FullNameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Age" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="AgeBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gender" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <ComboBox x:Name="GenderBox" BorderThickness="0" Background="Transparent"
                                          Padding="10,8" FontSize="14" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Phone Number *" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="PhoneBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="AddressBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="Basic Medical Notes (allergies / chronic conditions)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10">
                        <TextBox x:Name="NotesBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                 VerticalContentAlignment="Top" Padding="12,10"/>
                    </Border>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button Content="Save &amp; Add to Queue" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                    <Button Content="Cancel" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
