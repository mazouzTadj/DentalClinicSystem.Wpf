<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DentalClinic.NurseApp</RootNamespace>
    <AssemblyName>NurseApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- تسمح بقراءة App.config (سطر الاتصال بقاعدة البيانات) -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DentalClinic.Data\DentalClinic.Data.csproj" />
    <ProjectReference Include="..\DentalClinic.UI\DentalClinic.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
