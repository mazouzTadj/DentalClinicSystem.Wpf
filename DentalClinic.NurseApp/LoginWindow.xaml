<Window x:Class="DentalClinic.NurseApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Login_TitleNurse}" Height="560" Width="420"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط عنوان مخصّص: اختيار اللغة على جهة، زر إغلاق على الجهة الأخرى -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                            FlowDirection="LeftToRight">
                    <Button x:Name="EnglishLangButton" Content="{DynamicResource Login_English}" FontSize="12"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}" Padding="6,2"
                            Click="EnglishLangButton_Click"/>
                    <TextBlock Text="|" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="ArabicLangButton" Content="{DynamicResource Login_Arabic}" FontSize="12"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource TextSecondaryBrush}" Padding="6,2"
                            Click="ArabicLangButton_Click"/>
                </StackPanel>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="40,0,40,30" VerticalAlignment="Center">

                <Border Width="92" Height="92" CornerRadius="46" Background="White"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
                           Width="66" Height="66" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="{DynamicResource Login_TitleNurse}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <TextBlock Text="{DynamicResource Login_Username}" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16">
                    <TextBox x:Name="UsernameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                </Border>

                <TextBlock Text="{DynamicResource Login_Password}" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PlainPasswordBoxStyle}"
                                         KeyDown="PasswordBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource PlainTextBoxStyle}"
                                     Visibility="Collapsed" KeyDown="PasswordBox_KeyDown" TextChanged="PasswordVisibleBox_TextChanged"/>
                        </Grid>
                        <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" Content="👁" Width="34" Height="34"
                                      Style="{StaticResource IconToggleButtonStyle}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{DynamicResource Login_ShowPassword}"
                                      Checked="ShowPasswordToggle_Checked" Unchecked="ShowPasswordToggle_Unchecked"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                <Button Content="{DynamicResource Login_LoginButton}" Height="46" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
