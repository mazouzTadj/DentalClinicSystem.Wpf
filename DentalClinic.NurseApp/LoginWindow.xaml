<Window x:Class="DentalClinic.NurseApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="540" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط عنوان مخصّص: قابل للسحب، وزر إغلاق فقط -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="40,0,40,30" VerticalAlignment="Center">

                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="&#129468;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Reception Login" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16">
                    <TextBox x:Name="UsernameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                </Border>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,6">
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PlainPasswordBoxStyle}"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                <Button Content="Login" Height="46" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
