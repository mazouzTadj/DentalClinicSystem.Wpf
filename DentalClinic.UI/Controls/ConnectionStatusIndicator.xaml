<UserControl x:Class="DentalClinic.UI.Controls.ConnectionStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                MouseLeftButtonUp="Root_MouseLeftButtonUp" x:Name="Root">
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                 Fill="#27AE60"/>
        <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" Foreground="#6B7280"/>
    </StackPanel>
</UserControl>
