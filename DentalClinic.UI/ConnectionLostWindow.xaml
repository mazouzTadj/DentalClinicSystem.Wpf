<Window x:Class="DentalClinic.UI.ConnectionLostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#2C3E50" CornerRadius="10" Padding="16,12" MaxWidth="340">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="18" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#9888;" FontSize="20" Foreground="#F1C40F" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="{DynamicResource Conn_LostTitle}" FontWeight="Bold" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Conn_LostSubtitle}" Foreground="#BDC3C7" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
