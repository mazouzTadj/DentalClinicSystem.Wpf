<Window x:Class="DentalClinic.DoctorApp.AddExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Expense" Height="420" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Add New Expense" FontSize="18" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>

            <!-- Category -->
            <TextBlock Text="Category" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="CategoryComboBox" Height="35" FontSize="14" Padding="5" Margin="0,0,0,12" SelectedIndex="0">
                <ComboBoxItem Content="Medical Supplies &amp; Anesthesia"/>
                <ComboBoxItem Content="Dental Lab Fees"/>
                <ComboBoxItem Content="Salaries &amp; Staff Wages"/>
                <ComboBoxItem Content="Bills &amp; Utilities"/>
                <ComboBoxItem Content="Equipment Maintenance"/>
                <ComboBoxItem Content="Clinic Rent"/>
                <ComboBoxItem Content="General / Other"/>
            </ComboBox>

            <!-- Amount -->
            <TextBlock Text="Amount" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountBox" Height="35" FontSize="14" Padding="5" Margin="0,0,0,12"/>

            <!-- Description -->
            <TextBlock Text="Description" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionBox" Height="35" FontSize="14" Padding="5" Margin="0,0,0,12"/>

            <!-- Date -->
            <TextBlock Text="Date" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <DatePicker x:Name="ExpenseDatePicker" Height="35" FontSize="14" Padding="5" Margin="0,0,0,20"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
                <Button Grid.Column="2" Content="Save" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>