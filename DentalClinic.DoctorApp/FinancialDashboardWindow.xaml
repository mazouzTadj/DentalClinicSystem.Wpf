<Window x:Class="DentalClinic.DoctorApp.FinancialDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financial Dashboard" Height="780" Width="1100" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Financial Dashboard" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button Content="Refresh" Width="100" Height="38" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- بطاقات الملخص المالي -->
                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
                    <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <StackPanel>
                            <Border Height="4" CornerRadius="2" Background="#2E86DE" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                            <TextBlock Text="TODAY" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodayRevenueText" Text="0.00" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <StackPanel>
                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                            <TextBlock Text="THIS MONTH" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthRevenueText" Text="0.00" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <StackPanel>
                            <Border Height="4" CornerRadius="2" Background="#8E44AD" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                            <TextBlock Text="THIS YEAR" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="YearRevenueText" Text="0.00" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="14" Padding="18">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <StackPanel>
                            <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                            <TextBlock Text="OUTSTANDING" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OutstandingText" Text="0.00" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- صف الرسمين البيانيين -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Height="220">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Patients per Day (last 14 days)" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="DailyChartItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="34" Margin="3,0" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding ValueText}" FontSize="9" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Border Background="{StaticResource AccentBrush}" Height="{Binding BarHeight}"
                                                        CornerRadius="4,4,0,0" Margin="3,0"/>
                                                <TextBlock Text="{Binding Label}" FontSize="8.5" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20" Height="220">
                        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Most Common Treatments" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <TextBlock x:Name="NoTreatmentsText" Text="Not enough data yet"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="TreatmentBarItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Grid.Column="1" Background="{StaticResource AccentBrush}" Height="14"
                                                    CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- المستحقات المتبقية -->
                <TextBlock Text="Outstanding Balances" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="260">
                    <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
                    <DataGrid x:Name="OutstandingGrid"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                              RowStyle="{StaticResource ModernRowStyle}"
                              CellStyle="{StaticResource ModernCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientFullName}" Width="1.4*"/>
                            <DataGridTextColumn Header="PHONE" Binding="{Binding PhoneNumber}" Width="140"/>
                            <DataGridTextColumn Header="LAST VISIT" Binding="{Binding LastVisitText}" Width="140"/>
                            <DataGridTextColumn Header="AMOUNT OWED" Binding="{Binding TotalOwedText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
