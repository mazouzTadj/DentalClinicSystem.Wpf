<Window x:Class="DentalClinic.DoctorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        Title="Doctor App" Height="750" Width="1300" MinWidth="1040" MinHeight="550"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Open Patient File" Width="180" Height="42"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenFileButton_Click"/>
                <Button DockPanel.Dock="Left" Content="Advanced Search" Width="150" Height="42" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AdvancedSearchButton_Click"/>
                <Button DockPanel.Dock="Left" Content="Backup" Width="100" Height="42" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackupButton_Click"/>
                <!-- مخفي افتراضياً - يظهر فقط إذا كان المستخدم الحالي مديراً عاماً (IsAdmin) -->
                <Button x:Name="ManageUsersButton" DockPanel.Dock="Left" Content="Manage Users" Width="140" Height="42" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                        Click="ManageUsersButton_Click"/>
                <Button x:Name="FinancialDashboardButton" DockPanel.Dock="Left" Content="Finances" Width="110" Height="42" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                        Click="FinancialDashboardButton_Click"/>
                <Button Content="Logout" DockPanel.Dock="Right" Width="100" Height="42"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click"/>
                <Button Content="Refresh" DockPanel.Dock="Right" Width="100" Height="42" Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <!-- الشريط السفلي -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة قائمة الانتظار -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="QueueGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="QueueGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PATIENT NAME" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="CHECK-IN TIME" Binding="{Binding CheckInTimeText}" Width="160"/>
                    <DataGridTemplateColumn Header="STATUS" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusText, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ACTIONS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel" Height="26" Width="72" FontSize="11"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                        Tag="{Binding}" Click="CancelVisitButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
