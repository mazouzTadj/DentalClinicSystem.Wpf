<Window x:Class="DentalClinic.DoctorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        Title="{DynamicResource App_DoctorTitle}" Height="750" Width="1300" MinWidth="1040" MinHeight="550"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <!-- تم إضافة LastChildFill="False" لتجنب تمدد أي زر بشكل غير مرغوب -->
            <DockPanel LastChildFill="False">
                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.RegisterPatients -->
                <Button x:Name="RegisterPatientButton" DockPanel.Dock="Left" Content="{DynamicResource Main_RegisterPatient}" Width="180" Height="42"
                Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                Click="RegisterPatientButton_Click"/>
                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.OpenPatientFile -->
                <Button x:Name="OpenPatientFileButton" DockPanel.Dock="Left" Content="{DynamicResource Main_OpenPatientFile}" Width="180" Height="42" Margin="12,0,0,0"
                Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                Click="OpenFileButton_Click"/>
                <Button DockPanel.Dock="Left" Content="{DynamicResource Main_Search}" Width="150" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="AdvancedSearchButton_Click"/>

                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.CollectPayments -->
                <Button x:Name="CollectPaymentButton" DockPanel.Dock="Left" Content="{DynamicResource Main_CollectPayment}" Width="130" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                Click="CollectPaymentButton_Click"/>

                <!-- 🩺 زر إدارة العلاجات والأسعار - يظهر فقط لمن يملك صلاحية UserPermission.ManageTreatments -->
                <Button x:Name="ManageTreatmentsButton" DockPanel.Dock="Left" Content="{DynamicResource Main_Treatments}" Width="130" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                Click="ManageTreatmentsButton_Click"/>

                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.AccessBackup -->
                <Button x:Name="BackupButton" DockPanel.Dock="Left" Content="{DynamicResource Main_Backup}" Width="100" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                Click="BackupButton_Click"/>

                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.ManageUsers -->
                <Button x:Name="ManageUsersButton" DockPanel.Dock="Left" Content="{DynamicResource Main_ManageUsers}" Width="140" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                Click="ManageUsersButton_Click"/>
                <!-- مخفي افتراضياً - يظهر فقط لمن يملك صلاحية UserPermission.AccessFinance -->
                <Button x:Name="FinancialDashboardButton" DockPanel.Dock="Left" Content="{DynamicResource Main_Finances}" Width="110" Height="42" Margin="12,0,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                Click="FinancialDashboardButton_Click"/>

                <!-- الأزرار على جهة اليمين -->
                <Button DockPanel.Dock="Right" Content="{DynamicResource Main_Logout}" Width="100" Height="42"
                Style="{StaticResource DangerButtonStyle}"
                Click="LogoutButton_Click"/>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Main_Refresh}" Width="100" Height="42" Margin="0,0,12,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <!-- الشريط السفلي -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة قائمة الانتظار -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="QueueGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="QueueGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Main_ColPatientName}" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Main_ColCheckInTime}" Binding="{Binding CheckInTimeText}" Width="160"/>
                    <DataGridTemplateColumn Header="{DynamicResource Main_ColStatus}" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource Main_ColActions}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- إصلاح: زر تسجيل الحضور لموعد محجوز (Scheduled) وصل يومه فعلياً -->
                                    <Button Content="{DynamicResource Main_CheckIn}" Height="26" Width="72" FontSize="11" Margin="0,0,6,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CheckInButton_Click"/>
                                    <Button Content="{DynamicResource Main_Cancel}" Height="26" Width="72" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="CancelVisitButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
