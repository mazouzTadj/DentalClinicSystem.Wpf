<Window x:Class="DentalClinic.DoctorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doctor App" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <!-- شاشة مؤقتة فقط للتأكد من أن المشروع يبني ويعمل بنجاح بعد تسجيل الدخول.
         لوحة التحكم الفعلية (قائمة الانتظار + فتح ملف المريض) سنبنيها في الخطوة القادمة. -->
    <Grid>
        <TextBlock Text="Dashboard coming in the next step..." FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</Window>
