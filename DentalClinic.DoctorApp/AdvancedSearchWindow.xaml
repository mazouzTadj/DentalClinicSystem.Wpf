<Window x:Class="DentalClinic.DoctorApp.AdvancedSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بحث متقدم" Height="700" Width="1100" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <DockPanel LastChildFill="True">

        <!-- بطاقة معايير البحث -->
        <Border DockPanel.Dock="Top" Background="White" Margin="24,24,24,0" CornerRadius="14" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="معايير البحث (كل الحقول اختيارية)" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم المريض أو الهاتف" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TextBox x:Name="NameOrPhoneBox" Style="{StaticResource PlainTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="التشخيص يحتوي على" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TextBox x:Name="DiagnosisBox" Style="{StaticResource PlainTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="رقم السن" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TextBox x:Name="ToothBox" Style="{StaticResource PlainTextBoxStyle}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="من تاريخ" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <DatePicker x:Name="FromDatePicker" BorderThickness="0" Background="Transparent" Padding="8,6"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="إلى تاريخ" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <DatePicker x:Name="ToDatePicker" BorderThickness="0" Background="Transparent" Padding="8,6"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,3">
                        <CheckBox x:Name="OutstandingOnlyCheck" VerticalAlignment="Center"/>
                        <TextBlock Text="الرصيد المستحق فقط" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="6" Content="بحث" Height="38" VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}" Click="SearchButton_Click"/>

                    <Button Grid.Column="8" Content="مسح" Height="38" VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}" Click="ClearButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- شريط سفلي: عدد النتائج + فتح ملف المريض المحدَّد -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <DockPanel>
                <TextBlock x:Name="ResultCountText" DockPanel.Dock="Left"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="  (انقر مرتين على الصف، أو حدده ثم اضغط فتح)"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           VerticalAlignment="Center" FontStyle="Italic"/>
                <Button Content="فتح ملف المريض" Width="160" Height="34" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" FontSize="12"
                        Click="OpenPatientFileButton_Click"/>
            </DockPanel>
        </Border>

        <!-- بطاقة النتائج -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="ResultsGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المريض" Binding="{Binding PatientFullName}" Width="1.3*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding PatientPhone}" Width="130"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="140"/>
                    <DataGridTextColumn Header="التشخيص" Binding="{Binding Diagnosis}" Width="1.4*"/>
                    <DataGridTextColumn Header="العلاج" Binding="{Binding Treatment}" Width="1.4*"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="90"/>
                    <DataGridTextColumn Header="مدفوع" Binding="{Binding PaidText}" Width="90"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
