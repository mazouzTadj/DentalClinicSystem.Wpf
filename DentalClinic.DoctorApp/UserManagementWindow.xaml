<Window x:Class="DentalClinic.DoctorApp.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management" Height="620" Width="920" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="User Management" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button Content="+ Add User" Width="130" Height="40" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                        Click="AddUserButton_Click"/>
                <Button Content="Toggle Active" Width="120" Height="40" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                        Click="ToggleActiveButton_Click"/>
                <Button Content="Edit Selected" Width="120" Height="40" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="EditUserButton_Click"/>
            </DockPanel>
        </Border>

        <!-- شريط سفلي -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,12">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>

        <!-- بطاقة الجدول -->
        <Border Margin="24" Background="White" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid x:Name="UsersGrid"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="UsersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="1.4*"/>
                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1*"/>
                    <DataGridTextColumn Header="ROLE" Binding="{Binding RoleText}" Width="90"/>
                    <DataGridTextColumn Header="ADMIN" Binding="{Binding AdminText}" Width="80"/>
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#22A06B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                    <Setter Property="Background" Value="#9CA3AF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLoginText}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
