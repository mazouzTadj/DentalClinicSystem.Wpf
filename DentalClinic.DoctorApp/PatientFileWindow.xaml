<Window x:Class="DentalClinic.DoctorApp.PatientFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        Title="Patient File" Height="870" Width="800" MinWidth="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط علوي مخصّص -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Patient File" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- زر الوصفة الطبية -->
                    <Button x:Name="PrescriptionButton" Content="Prescription" Height="30" Width="90"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="PrescriptionButton_Click"/>

                    <!-- زر التصدير إلى PDF -->
                    <Button x:Name="ExportPdfButton" Content="Export to PDF" Height="30" Width="110"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="ExportPdfButton_Click"/>

                    <!-- 📅 زر حجز موعد جديد (تمت إضافته هنا) -->
                    <Button x:Name="ScheduleAppointmentButton" Content="📅 Schedule Next Visit" Height="30" Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,8,0" Click="ScheduleAppointmentButton_Click"/>

                    <!-- زر الإغلاق -->
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <!-- معلومات المريض -->
                    <TextBlock x:Name="PatientHeaderText" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PatientInfoText" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- السجل الطبي السابق -->
                    <TextBlock Text="Previous Visit History" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1" ClipToBounds="True" Height="170" Margin="0,0,0,22">
                        <DataGrid x:Name="HistoryGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="140"/>
                                <DataGridTextColumn Header="DIAGNOSIS" Binding="{Binding Diagnosis}" Width="*"/>
                                <DataGridTextColumn Header="TREATMENT" Binding="{Binding Treatment}" Width="*"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="80"/>
                                <DataGridTextColumn Header="PAID" Binding="{Binding PaidText}" Width="80"/>
                                <DataGridTextColumn Header="REMAINING" Binding="{Binding RemainingText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- جلسة اليوم -->
                    <TextBlock Text="Today's Session" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PrefillNoticeText" FontSize="11.5" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                               Visibility="Collapsed"
                               Text="Pre-filled from the last visit — please review and update before saving."/>

                    <TextBlock Text="Reason for Visit" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="ChiefComplaintBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="Diagnosis" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="DiagnosisBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top"/>
                    </Border>

                    <TextBlock Text="Treatment" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="TreatmentBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top"/>
                    </Border>

                    <TextBlock Text="Affected Tooth (optional)" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Padding="14,12" Margin="0,0,0,14">
                        <controls:OdontogramControl x:Name="Odontogram"/>
                    </Border>

                    <TextBlock Text="Medication" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="MedicationBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Price *" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="TotalPriceBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Amount Paid" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="PaidAmountBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button x:Name="SaveSessionButton" Content="Save Session &amp; Complete Visit" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveSessionButton_Click"/>
                    <Button Content="Close" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>