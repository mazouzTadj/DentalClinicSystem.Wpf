<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="DentalClinicDB"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DentalClinicDB_Test;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="BackupFolderPath" value="C:\DentalClinicBackups" />
		<add key="BackupRetainDays" value="14" />
	</appSettings>
</configuration>
