<Application x:Class="DentalClinic.ProsthetistApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DentalClinic.UI;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- لون تطبيق المرمم: بنفسجي - يميّزه بصرياً عن الطبيب (اللون الأساسي) والممرضة (أزرق) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#7A4FB5"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
