<Window x:Class="DentalClinic.ProsthetistApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DentalClinic.UI;assembly=DentalClinic.UI"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        xmlns:conv="clr-namespace:DentalClinic.UI.Converters;assembly=DentalClinic.UI"
        Title="{DynamicResource App_ProsthetistTitle}" Height="720" Width="1300" MinWidth="1040" MinHeight="560"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        ui:WindowFx.AnimateEntrance="True">

    <Window.Resources>
        <!-- ميزة تلوين حالة الملف (Open/Completed/Cancelled) بنفس أسلوب شارات حالة الزيارة في تطبيق الطبيب -->
        <conv:ProstheticCaseStatusToBrushConverter x:Key="ProstheticCaseStatusToBrushConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- الشريط العلوي -->
        <Border DockPanel.Dock="Top" Background="White" Padding="24,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="{DynamicResource App_ProsthetistTitle}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Main_Logout}" DockPanel.Dock="Right" Width="90" Height="42"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click"/>
                <controls:ConnectionStatusIndicator x:Name="ConnectionStatusIndicatorControl" DockPanel.Dock="Right" Margin="0,0,14,0"/>
                <Button Content="{DynamicResource Main_Refresh}" DockPanel.Dock="Right" Width="90" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"/>
                <!-- Patch 11.1: مقيَّدة بنفس صلاحية لوحة الفاينانس أدناه (ViewFinance) - راجع
                     StatisticsButton.Visibility في الكود الخلفي -->
                <Button x:Name="StatisticsButton" Content="{DynamicResource ProsthMain_OpenStatistics}"
                        DockPanel.Dock="Right" Width="110" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="StatisticsButton_Click"/>
                <!-- Patch 12: نفس صلاحية ViewFinance أيضاً - نافذة مصاريف المرمم (ProstheticExpenses)
                     مستقلة تماماً عن فاينانس العيادة العام، راجع ExpensesButton.Visibility في الكود الخلفي -->
                <Button x:Name="ExpensesButton" Content="{DynamicResource ProsthMain_OpenExpenses}"
                        DockPanel.Dock="Right" Width="110" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExpensesButton_Click"/>
                <!-- ميزة إضافة نظام حجز المواعيد لتطبيق المرمم: مواعيد اليوم والقادمة (اسم المريض +
                     العلاج) - مقيَّد بـProsthetics.ViewAppointments، راجع AppointmentsButton.Visibility
                     في الكود الخلفي -->
                <Button x:Name="AppointmentsButton" Content="{DynamicResource ProsthMain_OpenAppointmentsOverview}"
                        DockPanel.Dock="Right" Width="110" Height="42" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AppointmentsButton_Click"/>
            </DockPanel>
        </Border>

        <!-- بطاقات مالية - تظهر فقط لمن يملك صلاحية Prosthetics.ViewFinance -->
        <StackPanel x:Name="FinanceCardsPanel" DockPanel.Dock="Top" Margin="24,16,24,0" Visibility="Collapsed">
            <UniformGrid Columns="4" Rows="1">
                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Height="4" CornerRadius="2" Background="#2E86DE" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                        <TextBlock Text="{DynamicResource Fin_TodayRevenue}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TodayRevenueText" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                        <TextBlock Text="{DynamicResource Fin_ThisMonth}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MonthRevenueText" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Height="4" CornerRadius="2" Background="#8E44AD" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                        <TextBlock Text="{DynamicResource Fin_ThisYear}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="YearRevenueText" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="14" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                        <TextBlock Text="{DynamicResource Fin_Outstanding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OutstandingText" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- شريط البحث والفلترة -->
        <Border DockPanel.Dock="Top" Background="White" Margin="24,16,24,0" CornerRadius="10" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource InputContainerStyle}" Width="240" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBoxStyle}"
                             ToolTip="{DynamicResource ProsthMain_SearchPlaceholder}"
                             KeyDown="SearchBox_KeyDown"/>
                </Border>
                <Button Content="{DynamicResource ProsthMain_SearchButton}" Height="34" Padding="12,0"
                        Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                        Margin="0,0,16,0" Click="SearchButton_Click"/>

                <TextBlock Text="{DynamicResource ProsthCase_ColStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                <Border Style="{StaticResource InputContainerStyle}" Width="150" Margin="0,0,16,0">
                    <ComboBox x:Name="StatusFilterBox" BorderThickness="0" Background="Transparent"
                              Padding="10,6" FontSize="13" VerticalContentAlignment="Center"
                              SelectionChanged="StatusFilterBox_SelectionChanged">
                        <ComboBoxItem Tag="" Content="{DynamicResource ProsthMain_AllStatuses}" IsSelected="True"/>
                        <ComboBoxItem Tag="Open" Content="{DynamicResource ProsthCase_StatusOpen}"/>
                        <ComboBoxItem Tag="Completed" Content="{DynamicResource ProsthCase_StatusCompleted}"/>
                        <ComboBoxItem Tag="Cancelled" Content="{DynamicResource ProsthCase_StatusCancelled}"/>
                    </ComboBox>
                </Border>

                <CheckBox x:Name="ViewAllCasesToggle" Content="{DynamicResource ProsthMain_ViewAllCases}"
                          VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                          Checked="ViewAllCasesToggle_Changed" Unchecked="ViewAllCasesToggle_Changed"/>
            </StackPanel>
        </Border>

        <!-- تلميح "تحميل المزيد" + عدّاد النتائج -->
        <Border DockPanel.Dock="Bottom" Background="White" Padding="24,10" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSoftBrush}">
            <DockPanel>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="LoadMoreButton" Content="{DynamicResource ProsthMain_LoadMore}" DockPanel.Dock="Right"
                        Height="32" Padding="14,0" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                        Visibility="Collapsed" Click="LoadMoreButton_Click"/>
            </DockPanel>
        </Border>

        <!-- قائمة الانتظار -->
        <Border Margin="24,16,24,0" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="CasesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      CellStyle="{StaticResource ModernCellStyle}"
                      MouseDoubleClick="CasesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_ColCaseNumber}" Binding="{Binding CaseNumber}" Width="70"/>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_PatientName}" Binding="{Binding PatientFullName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_PatientPhone}" Binding="{Binding PatientPhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_Prosthetist}" Binding="{Binding ProsthetistName}" Width="150"/>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_WorkType}" Binding="{Binding WorkTypeName}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_ColStage}" Binding="{Binding StageName}" Width="120"/>
                    <!-- ميزة جديدة: الضغط على شارة الحالة نفسها يفتح نافذة تغيير الحالة مباشرة (بدل
                         زر منفصل أسفل الجدول) - Button بلا أي مظهر افتراضي (ControlTemplate كامل)
                         بحيث تبقى الشارة الملوَّنة نفسها بصرياً لكنها قابلة للنقر مع مؤشر يد -->
                    <DataGridTemplateColumn Header="{DynamicResource ProsthCase_ColStatus}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="StatusBadge_Click" Cursor="Hand"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                        ToolTip="{DynamicResource ProsthMain_ChangeStatusHint}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{Binding Case.CaseStatus, Converter={StaticResource ProstheticCaseStatusToBrushConverter}}"
                                                    CornerRadius="12" Padding="10,4">
                                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource ProsthCase_ColPrice}" Binding="{Binding PriceText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
