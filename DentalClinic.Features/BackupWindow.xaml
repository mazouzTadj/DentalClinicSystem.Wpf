<Window x:Class="DentalClinic.Features.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Backup_Title}" Height="620" Width="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,0,40,30">

                <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#128451;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{DynamicResource Backup_Title}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="{DynamicResource Backup_LastBackupLabel}" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16">
                    <TextBlock x:Name="LastBackupText" Padding="12,10" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <TextBlock Text="{DynamicResource Backup_FolderLabel}" Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource InputContainerStyle}" Margin="0,0,8,0">
                        <TextBox x:Name="FolderPathText" Padding="12,9" FontSize="13"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" Content="..." Width="58" Height="42"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BrowseFolderButton_Click"/>
                </Grid>

                <Button x:Name="SaveFolderButton" Content="{DynamicResource Common_Save}" Height="42" Margin="0,0,0,16"
                        Style="{StaticResource SecondaryButtonStyle}" Click="SaveFolderButton_Click"/>

                <TextBlock x:Name="RetentionText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,10"/>

                <TextBlock x:Name="StatusText" Style="{StaticResource ErrorTextStyle}"/>

                <!-- محتوى الزر يُدار بالكامل برمجياً (يتبدل بين "نسخ احتياطي الآن" و"جارٍ النسخ...") -->
                <Button x:Name="BackupNowButton" Height="46" Margin="0,10,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BackupNowButton_Click"/>
                <Button Content="{DynamicResource Common_Close}" Height="38" Margin="0,10,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
