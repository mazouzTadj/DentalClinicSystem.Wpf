<Window x:Class="DentalClinic.Features.EditIncomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Fin_EditIncomeTitle}" Height="260" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_EditIncomeTitle}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubHeaderText" DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
                <Button Grid.Column="2" Content="{DynamicResource Common_Save}" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_EditIncomeAmountLabel}" Style="{StaticResource FieldLabelStyle}"/>
            <Border DockPanel.Dock="Top" Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10">
                <TextBox x:Name="AmountBox" Style="{StaticResource PlainTextBoxStyle}"/>
            </Border>

            <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Style="{StaticResource ErrorTextStyle}"/>
        </DockPanel>
    </Border>
</Window>
