<Window x:Class="DentalClinic.Features.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UserEdit_TitleAdd}" Height="700" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <TextBlock Text="{DynamicResource UserEdit_FullName}" Style="{StaticResource FieldLabelStyle}" Margin="4,10,0,4"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="FullNameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="{DynamicResource UserEdit_Username}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="UsernameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock x:Name="PasswordLabel" Text="{DynamicResource UserEdit_PasswordNew}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PlainPasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource PlainTextBoxStyle}"
                                         Visibility="Collapsed" TextChanged="PasswordVisibleBox_TextChanged"/>
                            </Grid>
                            <ToggleButton x:Name="ShowPasswordToggle" Grid.Column="1" Content="👁" Width="34" Height="34"
                                          Style="{StaticResource IconToggleButtonStyle}" FontSize="13"
                                          VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{DynamicResource Login_ShowPassword}"
                                          Checked="ShowPasswordToggle_Checked" Unchecked="ShowPasswordToggle_Unchecked"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource UserEdit_Role}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <!-- Tag = القيمة الثابتة (Doctor/Nurse) المستخدَمة في المقارنات البرمجية
                                     Content = النص المعروض فقط (مترجَم حسب اللغة) -->
                                <ComboBox x:Name="RoleBox" BorderThickness="0" Background="Transparent"
                                          Padding="10,8" FontSize="14" VerticalContentAlignment="Center">
                                    <ComboBoxItem Tag="Doctor" Content="{DynamicResource UserMgmt_RoleDoctor}" IsSelected="True"/>
                                    <ComboBoxItem Tag="Nurse" Content="{DynamicResource UserMgmt_RoleNurse}"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource UserEdit_Phone}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="PhoneBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===== صلاحيات دقيقة ومستقلة عن الدور (Doctor/Nurse) ===== -->
                    <TextBlock Text="{DynamicResource UserEdit_PermissionsHeader}" Style="{StaticResource FieldLabelStyle}" Margin="4,0,0,6"/>
                    <Border Style="{StaticResource InputContainerStyle}" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermManageUsersCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermManageUsers}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermFinanceCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermFinance}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermPatientFileCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermPatientFile}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermBackupCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermBackup}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermTreatmentsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermTreatments}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="PermPaymentsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermPayments}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="PermRegisterPatientsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource UserEdit_PermRegisterPatients}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ActivePanel" Orientation="Horizontal" Margin="4,0,0,14">
                        <CheckBox x:Name="IsActiveCheck" VerticalAlignment="Center" IsChecked="True"/>
                        <TextBlock Text="{DynamicResource UserEdit_AccountActive}" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button Content="{DynamicResource Common_Save}" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                    <Button Content="{DynamicResource Common_Cancel}" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
