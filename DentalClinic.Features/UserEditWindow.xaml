<Window x:Class="DentalClinic.Features.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User" Height="700" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Add User" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <TextBlock Text="Full Name *" Style="{StaticResource FieldLabelStyle}" Margin="4,10,0,4"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="FullNameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="Username *" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="UsernameBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock x:Name="PasswordLabel" Text="Password *" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PlainPasswordBoxStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <ComboBox x:Name="RoleBox" BorderThickness="0" Background="Transparent"
                                          Padding="10,8" FontSize="14" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Doctor" IsSelected="True"/>
                                    <ComboBoxItem Content="Nurse"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="PhoneBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===== صلاحيات دقيقة ومستقلة عن الدور (Doctor/Nurse) ===== -->
                    <TextBlock Text="Permissions" Style="{StaticResource FieldLabelStyle}" Margin="4,0,0,6"/>
                    <Border Style="{StaticResource InputContainerStyle}" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermManageUsersCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Users (Super Admin)" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermFinanceCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Access Finance Dashboard" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermPatientFileCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Patient Files" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermBackupCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Access Backup" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PermTreatmentsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Treatments &amp; Prices" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="PermPaymentsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Collect Payments" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="PermRegisterPatientsCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="Register New Patients" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ActivePanel" Orientation="Horizontal" Margin="4,0,0,14">
                        <CheckBox x:Name="IsActiveCheck" VerticalAlignment="Center" IsChecked="True"/>
                        <TextBlock Text="Account is active" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button Content="Save" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                    <Button Content="Cancel" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
