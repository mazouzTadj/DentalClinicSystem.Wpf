<Window x:Class="DentalClinic.Features.ProstheticCaseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        Title="{DynamicResource ProsthCase_NewTitle}" Height="800" Width="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="{DynamicResource ProsthCase_NewTitle}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,0">

                <!-- ===== تبويب 1: معلومات الحالة (موجود منذ الباتش 2.2، بلا تغيير جوهري) ===== -->
                <TabItem Header="{DynamicResource ProsthCase_TabInfo}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,20">
                        <StackPanel>

                            <StackPanel x:Name="ReadOnlyInfoSection" Visibility="Collapsed">
                                <Border Style="{StaticResource InputContainerStyle}" Padding="12,10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource ProsthCase_ColCaseNumber}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="CaseNumberText" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource ProsthCase_ColStatus}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="StatusText" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource ProsthCase_PatientName}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PatientNameText" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource ProsthCase_PatientPhone}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="PatientPhoneText" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="NoProsthetistsHintText" Text="{DynamicResource ProsthCase_NoProsthetistsYet}"
                                       FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                       Margin="4,0,0,10" Visibility="Collapsed"/>

                            <TextBlock Text="{DynamicResource ProsthCase_Prosthetist}" Style="{StaticResource FieldLabelStyle}" Margin="4,4,0,4"/>
                            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                                <ComboBox x:Name="ProsthetistBox" BorderThickness="0" Background="Transparent"
                                          Padding="10,8" FontSize="14" VerticalContentAlignment="Center"/>
                            </Border>

                            <StackPanel x:Name="StageFieldPanel">
                                <TextBlock Text="{DynamicResource ProsthCase_ColStage}" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                                    <ComboBox x:Name="StageBox" BorderThickness="0" Background="Transparent"
                                              Padding="10,8" FontSize="14" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource ProsthCase_WorkType}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                                <ComboBox x:Name="WorkTypeBox" BorderThickness="0" Background="Transparent"
                                          Padding="10,8" FontSize="14" VerticalContentAlignment="Center"
                                          SelectionChanged="WorkTypeBox_SelectionChanged"/>
                            </Border>

                            <TextBlock Text="{DynamicResource ProsthCase_Arch}" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="4,4,0,4">
                                <CheckBox x:Name="IncludesUpperCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource ProsthCase_Upper}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="IncludesLowerCheck" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource ProsthCase_Lower}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource ProsthCase_ToothScope}" Style="{StaticResource FieldLabelStyle}" Margin="4,10,0,4"/>
                            <Border Style="{StaticResource InputContainerStyle}" Padding="14,12" Margin="0,0,0,14">
                                <controls:OdontogramControl x:Name="ToothScopeOdontogram"/>
                            </Border>

                            <TextBlock Text="{DynamicResource ProsthCase_TotalPrice}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                                <TextBox x:Name="TotalPriceBox" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>

                            <TextBlock Text="{DynamicResource ProsthCase_Notes}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14" MinHeight="70">
                                <TextBox x:Name="NotesBox" Style="{StaticResource PlainTextBoxStyle}"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                            <Button x:Name="SaveButton" Content="{DynamicResource Common_Save}" Height="46" Margin="0,10,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveButton_Click"/>
                            <Button Content="{DynamicResource Common_Cancel}" Height="38" Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelButton_Click"/>
                            <!-- Patch 12: زر حذف الحالة نهائياً - يظهر فقط في وضع التعديل (لا معنى له عند الإنشاء)
                                 ومقيَّد بصلاحية Prosthetics.DeleteCase (راجع _canDeleteCase) -->
                            <Button x:Name="DeleteCaseButton" Content="{DynamicResource ProsthCase_DeleteButton}" Height="38" Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}"
                                    Click="DeleteCaseButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== تبويب 2: الجلسات - يظهر فقط في وضع التعديل ===== -->
                <TabItem x:Name="SessionsTabItem" Header="{DynamicResource ProsthCase_TabSessions}">
                    <Grid Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="AddSessionButton" Grid.Row="0" Content="{DynamicResource ProsthSession_AddButton}"
                                Height="32" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                Click="AddSessionButton_Click"/>

                        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                      RowStyle="{StaticResource ModernRowStyle}"
                                      CellStyle="{StaticResource ModernCellStyle}"
                                      SelectionChanged="SessionsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource ProsthSession_Date}" Binding="{Binding DateText}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource ProsthSession_PerformedBy}" Binding="{Binding PerformedByText}" Width="140"/>
                                    <DataGridTextColumn Header="{DynamicResource ProsthSession_Description}" Binding="{Binding DescriptionText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="EditSessionButton" Content="{DynamicResource Common_Edit}" Height="32" Padding="12,0"
                                    Style="{StaticResource SecondaryButtonStyle}" FontSize="12" IsEnabled="False"
                                    Margin="0,0,8,0" Click="EditSessionButton_Click"/>
                            <Button x:Name="DeleteSessionButton" Content="{DynamicResource Common_Delete}" Height="32" Padding="12,0"
                                    Style="{StaticResource DangerButtonStyle}" FontSize="12" IsEnabled="False"
                                    Click="DeleteSessionButton_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ===== تبويب 3: المدفوعات - يظهر فقط لمن يملك Prosthetics.ViewPayment ===== -->
                <TabItem x:Name="PaymentsTabItem" Header="{DynamicResource ProsthCase_TabPayments}">
                    <Grid Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ملخص مالي سريع للحالة -->
                        <Border Grid.Row="0" Style="{StaticResource InputContainerStyle}" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <UniformGrid Columns="3" Rows="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ProsthCase_TotalPrice}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="AgreedPriceSummaryText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ProsthPayment_TotalPaid}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TotalPaidSummaryText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ProsthCase_ColOutstanding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="OutstandingSummaryText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="CreditSummaryText" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AddPaymentButton" Grid.Row="1" Content="{DynamicResource ProsthPayment_AddButton}"
                                Height="32" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                Click="AddPaymentButton_Click"/>

                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                      RowStyle="{StaticResource ModernRowStyle}"
                                      CellStyle="{StaticResource ModernCellStyle}"
                                      SelectionChanged="PaymentsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource ProsthSession_Date}" Binding="{Binding DateText}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource ProsthPayment_Amount}" Binding="{Binding AmountText}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource ProsthPayment_ReceivedBy}" Binding="{Binding ReceivedByText}" Width="140"/>
                                    <DataGridTextColumn Header="{DynamicResource ProsthCase_Notes}" Binding="{Binding NotesText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="EditPaymentButton" Content="{DynamicResource Common_Edit}" Height="32" Padding="12,0"
                                    Style="{StaticResource SecondaryButtonStyle}" FontSize="12" IsEnabled="False"
                                    Margin="0,0,8,0" Click="EditPaymentButton_Click"/>
                            <Button x:Name="DeletePaymentButton" Content="{DynamicResource Common_Delete}" Height="32" Padding="12,0"
                                    Style="{StaticResource DangerButtonStyle}" FontSize="12" IsEnabled="False"
                                    Click="DeletePaymentButton_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ===== تبويب 4: الملخص السريري (Patch 9) - قراءة فقط، لكل حقل صلاحيته المستقلة ===== -->
                <TabItem x:Name="ClinicalSummaryTabItem" Header="{DynamicResource ProsthCase_TabClinicalSummary}">
                    <Grid Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ClinicalSummaryEmptyText" Grid.Row="0"
                                   Text="{DynamicResource ProsthCase_ClinicalNoSessions}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   Margin="0,0,0,10" Visibility="Collapsed"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ClinicalSummaryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InputContainerStyle}" Padding="14,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                                <TextBlock Text="{DynamicResource ProsthCase_ClinicalDiagnosis}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding DiagnosisText}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8"/>

                                                <TextBlock Text="{DynamicResource ProsthCase_ClinicalTreatment}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding TreatmentText}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8"/>

                                                <TextBlock Text="{DynamicResource ProsthCase_ClinicalMedication}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding MedicationText}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ===== تبويب 5: History (Patch 10) - قراءة فقط بالكامل، لا تعديل ولا حذف إطلاقاً ===== -->
                <TabItem x:Name="HistoryTabItem" Header="{DynamicResource ProsthCase_TabHistory}">
                    <Grid Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="0"
                                   Text="{DynamicResource ProsthHistory_Empty}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   Margin="0,0,0,10" Visibility="Collapsed"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InputContainerStyle}" Padding="14,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FieldLabelText}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DetailText}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding UserText}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
