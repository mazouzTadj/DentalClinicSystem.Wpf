<Window x:Class="DentalClinic.Features.ScheduleAppointmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sched_Title}" Height="620" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان المخصص -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Sched_Title}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- محتوى النافذة -->
            <StackPanel Grid.Row="1" Margin="30,10,30,20">

                <!-- عنوان داخلي -->
                <TextBlock Text="{DynamicResource Sched_Header}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <!-- حقل التاريخ (بلا وقت - حُذف حقل الوقت بناءً على طلب العميل) -->
                <TextBlock Text="{DynamicResource Sched_DateLabel}" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16" Padding="5">
                    <DatePicker x:Name="DpAppointmentDate" BorderThickness="0" Background="Transparent" FontSize="14" VerticalAlignment="Center"
                                SelectedDateChanged="DpAppointmentDate_SelectedDateChanged">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <!-- الرقم 1.4 يعني تكبير بنسبة 40%، يمكنك تغييره حسب رغبتك -->
                                        <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>
                </Border>

                <!-- 🦷 العلاج المخطَّط لهذا الموعد - اختيار متعدد من نفس قائمة العلاجات المستخدَمة بملف المريض -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Sched_PlannedTreatment}" Style="{StaticResource FieldLabelStyle}"/>
                    <Button Grid.Column="1" Content="{DynamicResource PF_PickTreatmentsButton}" Height="26" Padding="10,0"
                            FontSize="11.5" Style="{StaticResource SecondaryButtonStyle}" Click="PickTreatmentsButton_Click"/>
                </Grid>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16" Padding="10" MinHeight="40">
                    <StackPanel>
                        <TextBlock x:Name="NoTreatmentsSelectedText" Text="{DynamicResource PF_NoTreatmentsSelected}"
                                   FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ItemsControl x:Name="SelectedTreatmentsItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" ✕" FontSize="11" Foreground="{StaticResource ErrorBrush}" Margin="6,0,0,0"
                                                       Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="RemoveTreatmentChip_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 📋 معاينة حية: كل المرضى المحجوزين بنفس اليوم المختار + علاجهم - حتى يشوف الطبيب حِمل
                     ذلك اليوم قبل ما يوافق على حجز إضافي قد يتجاوز وقت العمل المتاح -->
                <TextBlock Text="{DynamicResource Sched_SameDayPatients}" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,16" Padding="10" Height="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoSameDayPatientsText" Text="{DynamicResource Sched_NoSameDayPatients}"
                                       FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ItemsControl x:Name="SameDayPatientsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Treatment}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- أزرار الحفظ والإلغاء -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{DynamicResource Common_Cancel}" Width="120" Height="42" Margin="0,0,15,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancel_Click"/>
                    <Button Content="{DynamicResource Sched_SaveButton}" Width="160" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnSave_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
