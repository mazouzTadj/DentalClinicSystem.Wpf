<Window x:Class="DentalClinic.Features.CommissionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Commission_Title}" Height="560" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Commission_Header}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Commission_SubHeader}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- Default percent -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Commission_DefaultLabel}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="DefaultPercentBox" Height="34" FontSize="14" Padding="6,4" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Commission_DefaultHint}" FontSize="10.5" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
                <Button Grid.Column="2" Content="{DynamicResource Common_Save}" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
            </Grid>

            <!-- Per-doctor overrides -->
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Commission_PerDoctorLabel}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Commission_PrimaryPickerHint}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DoctorsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Center">
                                        <RadioButton GroupName="PrimaryDoctorGroup" IsChecked="{Binding IsPrimarySelected, Mode=TwoWay}"
                                                     HorizontalAlignment="Center" ToolTip="{DynamicResource Commission_SetPrimaryTooltip}"/>
                                        <TextBlock Text="👑" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SubText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             IsEnabled="{Binding IsEditable}" Tag="{Binding UserID}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
