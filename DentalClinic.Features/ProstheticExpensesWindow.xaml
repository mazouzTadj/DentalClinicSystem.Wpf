<Window x:Class="DentalClinic.Features.ProstheticExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProsthExpense_WindowTitle}"
        Width="1000" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== العنوان ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource ProsthExpense_WindowTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="PeriodText" Text="" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="AddExpenseButton" Content="{DynamicResource ProsthExpense_AddButton}"
                    Width="130" Height="34" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddExpenseButton_Click"/>
            <Button Grid.Column="2" Content="{DynamicResource ProsthStats_Close}" Width="90" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"/>
        </Grid>

        <!-- ===== شريط الفلاتر: المرمم + الفترة (نفس بنية ProstheticStatisticsWindow) ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,8,0,0"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ProsthStats_ProsthetistLabel}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Width="200" Height="38" CornerRadius="10" Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,18,0">
                        <ComboBox x:Name="ProsthetistFilterCombo"
                                  Width="198" MinWidth="198" Height="36"
                                  Margin="0"
                                  TextSearch.TextPath="FullName"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ProsthetistFilterCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <Button x:Name="TodayButton" Content="{DynamicResource ProsthStats_Today}" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="TodayButton_Click"/>
                    <Button x:Name="WeekButton" Content="{DynamicResource ProsthStats_ThisWeek}" Width="100" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="WeekButton_Click"/>
                    <Button x:Name="MonthButton" Content="{DynamicResource ProsthStats_ThisMonth}" Width="100" Height="34" Margin="0,0,18,0" Style="{StaticResource SecondaryButtonStyle}" Click="MonthButton_Click"/>

                    <TextBlock Text="{DynamicResource ProsthStats_From}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker x:Name="FromDatePicker" Width="130" Height="34" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource ProsthStats_To}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker x:Name="ToDatePicker" Width="130" Height="34" Margin="0,0,10,0"/>

                    <Button Content="{DynamicResource ProsthStats_Apply}" Width="110" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyFilterButton_Click"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== بطاقات الملخص ===== -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource ProsthStats_TotalPayments}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="TotalPaymentsText" FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource ProsthExpense_TotalExpenses}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="TotalExpensesText" FontSize="18" FontWeight="Bold" Foreground="#E67E22" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource ProsthStats_NetIncome}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="NetIncomeText" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== قائمة المصاريف ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="EmptyText" Grid.Row="0" Text="{DynamicResource ProsthExpense_NoData}"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed"/>
            <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="ExpensesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernRowStyle}"
                          CellStyle="{StaticResource ModernCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Fin_ColDate}" Binding="{Binding DateText}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource ProsthStats_ColProsthetist}" Binding="{Binding ProsthetistName}" Width="160"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_ColCategory}" Binding="{Binding Category}" Width="160"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_ColDescription}" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_ColAmount}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                        <DataGridTemplateColumn x:Name="EditColumn" Header="{DynamicResource Fin_ColActions}" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✏" ToolTip="{DynamicResource Expense_EditTooltip}" Width="30" Height="26"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13"
                                            Foreground="{StaticResource TextSecondaryBrush}" Tag="{Binding}" Click="EditExpenseButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="DeleteColumn" Header="{DynamicResource Fin_ColActions}" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" ToolTip="{DynamicResource Expense_DeleteTooltip}" Width="30" Height="26"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13"
                                            Foreground="{StaticResource ErrorBrush}" Tag="{Binding}" Click="DeleteExpenseButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
