<Window x:Class="DentalClinic.Features.PatientFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        Title="ملف المريض" Height="870" Width="800" MinWidth="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط علوي مخصّص -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="ملف المريض" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- زر الوصفة الطبية -->
                    <Button x:Name="PrescriptionButton" Content="الوصفة الطبية" Height="30" Width="90"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="PrescriptionButton_Click"/>

                    <!-- زر التصدير إلى PDF -->
                    <Button x:Name="ExportPdfButton" Content="تصدير إلى PDF" Height="30" Width="110"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="ExportPdfButton_Click"/>

                    <!-- 📅 زر حجز موعد جديد -->
                    <Button x:Name="ScheduleAppointmentButton" Content="📅 حجز الزيارة القادمة" Height="30" Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,8,0" Click="ScheduleAppointmentButton_Click"/>

                    <!-- زر الإغلاق -->
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <!-- معلومات المريض -->
                    <TextBlock x:Name="PatientHeaderText" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PatientInfoText" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- السجل الطبي السابق -->
                    <TextBlock Text="سجل الزيارات السابقة" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1" ClipToBounds="True" Height="170" Margin="0,0,0,22">
                        <DataGrid x:Name="HistoryGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="140"/>
                                <DataGridTextColumn Header="التشخيص" Binding="{Binding Diagnosis}" Width="*"/>
                                <DataGridTextColumn Header="العلاج" Binding="{Binding Treatment}" Width="*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalText}" Width="80"/>
                                <DataGridTextColumn Header="مدفوع" Binding="{Binding PaidText}" Width="80"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- جلسة اليوم -->
                    <TextBlock Text="جلسة اليوم" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PrefillNoticeText" FontSize="11.5" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                               Visibility="Collapsed"
                               Text="معبّأ مسبقًا من آخر زيارة — يرجى المراجعة والتحديث قبل الحفظ."/>

                    <TextBlock Text="سبب الزيارة" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="ChiefComplaintBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="التشخيص" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="DiagnosisBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top"/>
                    </Border>

                    <!-- 🦷 خانة العلاج: ComboBox اختيار من القائمة أو كتابة علاج مخصص -->
                    <TextBlock Text="العلاج" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14" Padding="5,2">
                        <ComboBox x:Name="CmbTreatment" BorderThickness="0" Background="Transparent" 
                                  FontSize="14" VerticalAlignment="Center" IsEditable="True"
                                  SelectionChanged="CmbTreatment_SelectionChanged"/>
                    </Border>

                    <TextBlock Text="السن المصاب (اختياري)" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Padding="14,12" Margin="0,0,0,14">
                        <controls:OdontogramControl x:Name="Odontogram"/>
                    </Border>

                    <TextBlock Text="الدواء" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="MedicationBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <!-- 💰 تحديد التكلفة الإجمالية فقط (تم إلغاء خانة الدفع) -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="التكلفة الإجمالية للعلاج (دج)" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TextBox x:Name="TotalPriceBox" Style="{StaticResource PlainTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button x:Name="SaveSessionButton" Content="حفظ الجلسة وإتمام العلاج الطبي" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveSessionButton_Click"/>
                    <Button Content="إغلاق" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>