<Window x:Class="DentalClinic.Features.PatientFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DentalClinic.UI.Controls;assembly=DentalClinic.UI"
        Title="{DynamicResource PF_Title}" Height="870" Width="800" MinWidth="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط علوي مخصّص -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource PF_Title}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- زر الوصفة الطبية -->
                    <Button x:Name="PrescriptionButton" Content="{DynamicResource PF_PrescriptionButton}" Height="30" Width="90"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="PrescriptionButton_Click"/>

                    <!-- زر التصدير إلى PDF -->
                    <Button x:Name="ExportPdfButton" Content="{DynamicResource PF_ExportPdfButton}" Height="30" Width="110"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="ExportPdfButton_Click"/>

                    <!-- 📅 زر حجز موعد جديد -->
                    <Button x:Name="ScheduleAppointmentButton" Content="{DynamicResource PF_ScheduleButton}" Height="30" Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,8,0" Click="ScheduleAppointmentButton_Click"/>

                    <!-- زر الإغلاق -->
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <!-- معلومات المريض -->
                    <TextBlock x:Name="PatientHeaderText" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PatientInfoText" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- السجل الطبي السابق -->
                    <TextBlock Text="{DynamicResource PF_HistoryHeader}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1" ClipToBounds="True" Height="170" Margin="0,0,0,22">
                        <DataGrid x:Name="HistoryGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource PF_ColDate}" Binding="{Binding DateText}" Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource PF_ColDiagnosis}" Binding="{Binding Diagnosis}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource PF_ColTreatment}" Binding="{Binding Treatment}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource PF_ColTotal}" Binding="{Binding TotalText}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource PF_ColPaid}" Binding="{Binding PaidText}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource PF_ColRemaining}" Binding="{Binding RemainingText}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- جلسة اليوم -->
                    <TextBlock Text="{DynamicResource PF_TodaySession}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PrefillNoticeText" FontSize="11.5" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                               Visibility="Collapsed"
                               Text="{DynamicResource PF_PrefillNotice}"/>

                    <TextBlock Text="{DynamicResource PF_ChiefComplaint}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="ChiefComplaintBox" Style="{StaticResource PlainTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="{DynamicResource PF_ColDiagnosis}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14">
                        <TextBox x:Name="DiagnosisBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top"/>
                    </Border>

                    <!-- 🦷 العلاج: اختيار متعدد من القائمة (يُجمَع السعر تلقائياً) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource PF_Treatments}" Style="{StaticResource FieldLabelStyle}"/>
                        <Button Grid.Column="1" x:Name="PickTreatmentsButton" Content="{DynamicResource PF_PickTreatmentsButton}" Height="26" Padding="10,0"
                                FontSize="11.5" Style="{StaticResource SecondaryButtonStyle}" Click="PickTreatmentsButton_Click"/>
                    </Grid>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14" Padding="10" MinHeight="46">
                        <StackPanel>
                            <TextBlock x:Name="NoTreatmentsSelectedText" Text="{DynamicResource PF_NoTreatmentsSelected}"
                                       FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ItemsControl x:Name="SelectedTreatmentsItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding PriceText}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                                                <TextBlock Text=" ✕" FontSize="11" Foreground="{StaticResource ErrorBrush}" Margin="6,0,0,0"
                                                           Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="RemoveTreatmentChip_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource PF_AffectedTooth}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Padding="14,12" Margin="0,0,0,14">
                        <controls:OdontogramControl x:Name="Odontogram"/>
                    </Border>

                    <!-- 💊 الأدوية: اختيار متعدد من القائمة - تظهر مباشرة في الوصفة الطبية عند فتحها -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource PF_Medications}" Style="{StaticResource FieldLabelStyle}"/>
                        <Button Grid.Column="1" x:Name="PickMedicationsButton" Content="{DynamicResource PF_PickMedicationsButton}" Height="26" Padding="10,0"
                                FontSize="11.5" Style="{StaticResource SecondaryButtonStyle}" Click="PickMedicationsButton_Click"/>
                    </Grid>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,14" Padding="10" MinHeight="46">
                        <StackPanel>
                            <TextBlock x:Name="NoMedicationsSelectedText" Text="{DynamicResource PF_NoMedicationsSelected}"
                                       FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ItemsControl x:Name="SelectedMedicationsItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" ✕" FontSize="11" Foreground="{StaticResource ErrorBrush}" Margin="6,0,0,0"
                                                           Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="RemoveMedicationChip_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 💰 تحديد التكلفة الإجمالية فقط (تم إلغاء خانة الدفع) -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource PF_TotalPriceLabel}" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TextBox x:Name="TotalPriceBox" Style="{StaticResource PlainTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                    <Button x:Name="SaveSessionButton" Content="{DynamicResource PF_SaveSessionButton}" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveSessionButton_Click"/>
                    <Button Content="{DynamicResource PF_CloseButton}" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
