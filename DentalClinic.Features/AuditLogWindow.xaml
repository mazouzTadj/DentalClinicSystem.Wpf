<Window x:Class="DentalClinic.Features.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Audit_Title}" Height="620" Width="900" MinWidth="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Audit_Title}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="30,10,30,14">
                <TextBlock Text="{DynamicResource Audit_Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource Common_Refresh}" Width="105" Height="38" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
            </Grid>
            <Border Grid.Row="2" Margin="30,0,30,10" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                <DataGrid x:Name="AuditGrid" Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Audit_ColTime}" Binding="{Binding OccurredAtText}" Width="150" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource Audit_ColAction}" Binding="{Binding Action}" Width="95" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource Audit_ColRecord}" Binding="{Binding EntityText}" Width="1.25*" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource Audit_ColUser}" Binding="{Binding ActorText}" Width="1.25*" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource Audit_ColDevice}" Binding="{Binding ClientHost}" Width="1*" ElementStyle="{StaticResource CellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="30,0,30,20" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>
    </Border>
</Window>
