<Window x:Class="DentalClinic.Features.LicenseRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DentalClinic.UI;assembly=DentalClinic.UI"
        Title="License Required" Height="620" Width="460"
        Icon="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ui:WindowFx.AnimateEntrance="True">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button Content="✕" HorizontalAlignment="Right" Margin="0,8,12,0" Width="28" Height="28"
                        Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="36,0,36,26" VerticalAlignment="Center">

                <Border Width="72" Height="72" CornerRadius="36" Background="White"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/DentalClinic.UI;component/Assets/logo_icon.png"
                           Width="48" Height="48" Stretch="Uniform"/>
                </Border>

                <TextBlock Text="License Required" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Text="This clinic's database has not been activated yet. Send the Installation ID below to the software provider to receive your license key."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Installation ID" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,8">
                    <TextBox x:Name="InstallationIdBox" Style="{StaticResource PlainTextBoxStyle}"
                             IsReadOnly="True" FontFamily="Consolas"/>
                </Border>
                <Button x:Name="CopyIdButton" Content="Copy Installation ID" Height="34" Margin="0,0,0,20"
                        Style="{StaticResource SecondaryButtonStyle}" Click="CopyIdButton_Click"/>

                <TextBlock Text="License Key" Style="{StaticResource FieldLabelStyle}"/>
                <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,6" Height="90">
                    <TextBox x:Name="LicenseKeyBox" Style="{StaticResource PlainTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>

                <Button x:Name="ActivateButton" Content="Activate" Height="46" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="ActivateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
