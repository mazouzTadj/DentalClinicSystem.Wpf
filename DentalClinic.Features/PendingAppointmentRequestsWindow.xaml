<Window x:Class="DentalClinic.Features.PendingAppointmentRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Notif_PendingRequestsTitle}" Height="600" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Notif_PendingRequestsTitle}" FontWeight="Bold" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="20,0,50,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="NoRequestsText" Text="{DynamicResource Notif_NoPendingRequests}"
                           FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RequestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PatientFullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding RequestedByLine}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>

                                        <TextBlock Text="{Binding CurrentLine}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ProposedLine}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                                        <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10">
                                            <TextBox Style="{StaticResource PlainTextBoxStyle}" FontSize="12"
                                                     Tag="{Binding}" Text="{Binding RejectionReasonDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Notif_RejectReasonPrompt}" FontSize="10.5"
                                                    Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,10"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Notif_RejectButton}" Width="90" Height="34" Margin="0,0,8,0"
                                                    Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="RejectButton_Click"/>
                                            <Button Content="{DynamicResource Notif_ApproveButton}" Width="110" Height="34"
                                                    Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Click="ApproveButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
