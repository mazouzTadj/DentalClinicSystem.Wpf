<Window x:Class="DentalClinic.Features.PatientSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Patient" Height="610" Width="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Search for an Existing Patient" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <!-- حقل البحث النصي -->
            <Grid Grid.Row="1" Margin="30,10,30,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource InputContainerStyle}">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBoxStyle}"
                             KeyDown="SearchBox_KeyDown"/>
                </Border>
                <Button Grid.Column="2" Content="Search" Style="{StaticResource PrimaryButtonStyle}"
                        Click="SearchButton_Click"/>
            </Grid>

            <!-- صف الفلاتر (الجنس + حالة الدفع) -->
            <Grid Grid.Row="2" Margin="30,0,30,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- فلتر الجنس -->
                <Border Grid.Column="0" Style="{StaticResource InputContainerStyle}">
                    <ComboBox x:Name="GenderFilterBox" BorderThickness="0" Background="Transparent"
                              Padding="10,8" FontSize="13" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Any Gender" IsSelected="True"/>
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                    </ComboBox>
                </Border>

                <!-- فلتر حالة الدفع (جديد) -->
                <Border Grid.Column="2" Style="{StaticResource InputContainerStyle}">
                    <ComboBox x:Name="PaymentFilterBox" BorderThickness="0" Background="Transparent"
                              Padding="10,8" FontSize="13" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="All Payment Statuses" IsSelected="True"/>
                        <ComboBoxItem Content="Has Unpaid Balance"/>
                        <ComboBoxItem Content="Fully Paid"/>
                    </ComboBox>
                </Border>
            </Grid>

            <!-- جدول النتائج -->
            <Border Grid.Row="3" Margin="30,0,30,10" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="ResultsGrid"
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernRowStyle}"
                          CellStyle="{StaticResource ModernCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="AGE" Binding="{Binding AgeText}" Width="60"/>
                        <DataGridTextColumn Header="PHONE" Binding="{Binding PhoneNumber}" Width="130"/>

                        <!-- عمود فتح الملف الطبي - العمود بأكمله يُخفى برمجياً في الكود الخلفي لمن لا يملك الصلاحية -->
                        <DataGridTemplateColumn x:Name="OpenFileColumn" Header="FILE" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Height="26" Width="65" FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Tag="{Binding}" Click="OpenPatientFileButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- عمود حالة الدفع -->
                        <DataGridTemplateColumn Header="PAYMENT" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Pay" Height="26" Width="65" FontSize="11"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Visibility="{Binding HasUnpaidBalance, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding}" Click="CollectPaymentButton_Click"/>

                                        <Border Background="#10B981" CornerRadius="6" Height="26" Width="65"
                                                Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}"
                                                ToolTip="All sessions paid in full">
                                            <TextBlock Text="Paid ✓" Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource ErrorTextStyle}" Margin="30,0,30,6"/>

            <!-- أزرار الإغلاق والإضافة -->
            <Grid Grid.Row="5" Margin="30,0,30,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Close" Height="42"
                        Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"/>
                <Button Grid.Column="2" Content="Add to Queue" Height="42"
                        Style="{StaticResource PrimaryButtonStyle}" Click="AddToQueueButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>