<Window x:Class="DentalClinic.Features.DoctorStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Fin_DoctorStatsWindowTitle}"
        Width="1250" Height="760" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Fin_DoctorStatsWindowTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="PeriodText" Text="" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Fin_Close}" Width="90" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="{DynamicResource Fin_Today}" Width="95" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="TodayButton_Click"/>
                <Button Content="{DynamicResource Fin_ThisMonthFilter}" Width="110" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="MonthButton_Click"/>
                <Button Content="{DynamicResource Fin_ThisYearFilter}" Width="100" Height="34" Margin="0,0,18,0" Style="{StaticResource SecondaryButtonStyle}" Click="YearButton_Click"/>
                <TextBlock Text="{DynamicResource Fin_From}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker x:Name="FromDatePicker" Width="135" Height="34" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Fin_To}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker x:Name="ToDatePicker" Width="135" Height="34" Margin="0,0,10,0"/>
                <ComboBox x:Name="DoctorFilterCombo"
                          Width="220" MinWidth="220" Height="36"
                          Margin="0,0,10,0"
                          IsEditable="False"
                          IsReadOnly="True"
                          SelectedIndex="0"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          FlowDirection="RightToLeft"
                          ToolTip="{DynamicResource Fin_DoctorFilterTooltip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{DynamicResource Fin_ApplyFilter}" Width="120" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyFilterButton_Click"/>
            </WrapPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_DoctorCount}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="DoctorCountText" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_PatientCount}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="PatientCountText" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_SessionCount}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="SessionCountText" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_TotalDoctorIncome}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="IncomeText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Margin="0,0,8,0" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_TotalDoctorCommission}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="CommissionText" FontSize="20" FontWeight="Bold" Foreground="#E67E22" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14">
                <StackPanel><TextBlock Text="{DynamicResource Fin_ClinicShare}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="ClinicShareText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Fin_DoctorDetailedTable}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TopDoctorText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <DataGrid x:Name="DoctorDetailsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}"
                          HeadersVisibility="Column" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Fin_Doctor}" Binding="{Binding DoctorName}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_PatientCount}" Binding="{Binding PatientCount}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_SessionCount}" Binding="{Binding SessionCount}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_TotalDoctorIncome}" Binding="{Binding GrossIncomeText}" Width="1.25*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_CommissionPercent}" Binding="{Binding CommissionPercentText}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_DoctorShare}" Binding="{Binding DoctorShareText}" Width="1.15*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_ClinicShare}" Binding="{Binding ClinicShareText}" Width="1.15*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_IncomePerPatient}" Binding="{Binding IncomePerPatientText}" Width="1.15*"/>
                        <DataGridTextColumn Header="{DynamicResource Fin_IncomeShare}" Binding="{Binding IncomeShareText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
