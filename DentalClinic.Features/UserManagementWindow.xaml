<Window x:Class="DentalClinic.Features.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UserMgmt_Title}" Height="620" Width="920" MinWidth="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- نسخة محلية من نمط خلايا الجدول، تُبقي النص عمودياً في منتصف الصف بدل الحشوة الثابتة
             الكبيرة اللي كانت تُطوّل الصف وتمدد شارة الحالة لتملأ ارتفاعه بالكامل - نفس مبدأ
             محاذاة صفوف قائمة الانتظار (لا نعدّل النمط العام ModernCellStyle حتى لا يتأثر أي جدول آخر) -->
        <Style x:Key="UserMgmtCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ModernCellStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource UserMgmt_Title}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <!-- شريط الأزرار -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,10,30,16">
                <Button Content="{DynamicResource Audit_OpenButton}" Width="115" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                        Click="AuditLogButton_Click"/>
                <Button Content="{DynamicResource UserMgmt_EditSelected}" Width="130" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                        Click="EditUserButton_Click"/>
                <Button Content="{DynamicResource UserMgmt_ToggleActive}" Width="130" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                        Click="ToggleActiveButton_Click"/>
                <Button Content="{DynamicResource UserMgmt_AddUser}" Width="130" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddUserButton_Click"/>
            </StackPanel>

            <!-- جدول المستخدمين -->
            <Border Grid.Row="2" Margin="30,0,30,10" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="UsersGrid"
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernRowStyle}"
                          CellStyle="{StaticResource UserMgmtCellStyle}"
                          MouseDoubleClick="UsersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource UserMgmt_ColFullName}" Binding="{Binding FullName}" Width="1.4*" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource UserMgmt_ColUsername}" Binding="{Binding Username}" Width="1*" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource UserMgmt_ColRole}" Binding="{Binding RoleText}" Width="90" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="{DynamicResource UserMgmt_ColAdmin}" Binding="{Binding AdminText}" Width="80" ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTemplateColumn Header="{DynamicResource UserMgmt_ColStatus}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,4" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22A06B"/>
                                                <Style.Triggers>
                                                    <!-- نربط على القيمة البوليانية الأصلية User.IsActive بدل النص المترجَم StatusText
                                                         حتى يبقى اللون صحيحاً بغض النظر عن اللغة المختارة -->
                                                    <DataTrigger Binding="{Binding User.IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#9CA3AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource UserMgmt_ColLastLogin}" Binding="{Binding LastLoginText}" Width="1*" ElementStyle="{StaticResource CellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" Margin="30,0,30,20"/>
        </Grid>
    </Border>
</Window>
