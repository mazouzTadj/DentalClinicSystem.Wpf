<Window x:Class="DentalClinic.Features.ProstheticLookupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProsthLookup_WindowTitle}" Height="680" Width="760" MinWidth="600" MinHeight="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الشريط العلوي -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource ProsthLookup_Header}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" HorizontalAlignment="Right" Margin="0,0,10,0"
                        Style="{StaticResource WindowControlButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- المحتوى الرئيسي -->
            <Grid Grid.Row="1" Margin="24,10,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- زر تبديل بين أنواع العمل والمراحل - نفس نمط TreatmentManagementWindow -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="TabWorkTypesButton" Content="{DynamicResource ProsthLookup_TabWorkTypes}" Height="34" Padding="18,0"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="TabWorkTypes_Click"/>
                    <Button x:Name="TabStagesButton" Content="{DynamicResource ProsthLookup_TabStages}" Height="34" Padding="18,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="TabStages_Click"/>
                </StackPanel>

                <!-- ===================== لوحة أنواع العمل ===================== -->
                <Grid x:Name="WorkTypesPanelGrid" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نموذج الإضافة والتعديل -->
                    <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ProsthLookup_Name}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="TxtWorkTypeName" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>

                            <TextBlock Text="{DynamicResource ProsthLookup_Price}" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="TxtWorkTypePrice" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>

                            <TextBlock x:Name="WorkTypeErrorText" Style="{StaticResource ErrorTextStyle}" Margin="0,6,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="BtnCancelWorkTypeEdit" Content="{DynamicResource ProsthLookup_CancelEdit}" Width="100" Height="36" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                                        Click="BtnCancelWorkTypeEdit_Click"/>
                                <Button x:Name="BtnSaveWorkTypeButton" Content="{DynamicResource ProsthLookup_AddButton}" Width="140" Height="36"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnSaveWorkType_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- جدول عرض أنواع العمل -->
                    <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="WorkTypesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColName}" Binding="{Binding WorkTypeName}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColPrice}" Binding="{Binding PriceText}" Width="90"/>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColOrder}" Binding="{Binding SortOrder}" Width="70"/>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColStatus}" Binding="{Binding ActiveText}" Width="90"/>

                                <DataGridTemplateColumn Header="{DynamicResource ProsthLookup_ColActions}" Width="270">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#9650;" ToolTip="{DynamicResource ProsthLookup_MoveUp}" Height="26" Width="30" FontSize="10" Margin="0,0,4,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnMoveWorkTypeUp_Click"/>
                                                <Button Content="&#9660;" ToolTip="{DynamicResource ProsthLookup_MoveDown}" Height="26" Width="30" FontSize="10" Margin="0,0,10,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnMoveWorkTypeDown_Click"/>
                                                <Button Content="{DynamicResource ProsthLookup_EditButton}" Height="26" Width="55" FontSize="11" Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnEditWorkType_Click"/>
                                                <Button Content="{DynamicResource ProsthLookup_DeleteButton}" Height="26" Width="60" FontSize="11"
                                                        Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnDeleteWorkType_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ===================== لوحة المراحل ===================== -->
                <Grid x:Name="StagesPanelGrid" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نموذج الإضافة والتعديل -->
                    <Border Grid.Row="0" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ProsthLookup_Name}" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource InputContainerStyle}">
                                <TextBox x:Name="TxtStageName" Style="{StaticResource PlainTextBoxStyle}"/>
                            </Border>

                            <TextBlock x:Name="StageErrorText" Style="{StaticResource ErrorTextStyle}" Margin="0,6,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="BtnCancelStageEdit" Content="{DynamicResource ProsthLookup_CancelEdit}" Width="100" Height="36" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                                        Click="BtnCancelStageEdit_Click"/>
                                <Button x:Name="BtnSaveStageButton" Content="{DynamicResource ProsthLookup_AddButton}" Width="140" Height="36"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnSaveStage_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- جدول عرض المراحل -->
                    <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="StagesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColName}" Binding="{Binding StageName}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColOrder}" Binding="{Binding SortOrder}" Width="70"/>
                                <DataGridTextColumn Header="{DynamicResource ProsthLookup_ColStatus}" Binding="{Binding ActiveText}" Width="90"/>

                                <DataGridTemplateColumn Header="{DynamicResource ProsthLookup_ColActions}" Width="270">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#9650;" ToolTip="{DynamicResource ProsthLookup_MoveUp}" Height="26" Width="30" FontSize="10" Margin="0,0,4,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnMoveStageUp_Click"/>
                                                <Button Content="&#9660;" ToolTip="{DynamicResource ProsthLookup_MoveDown}" Height="26" Width="30" FontSize="10" Margin="0,0,10,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnMoveStageDown_Click"/>
                                                <Button Content="{DynamicResource ProsthLookup_EditButton}" Height="26" Width="55" FontSize="11" Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="BtnEditStage_Click"/>
                                                <Button Content="{DynamicResource ProsthLookup_DeleteButton}" Height="26" Width="60" FontSize="11"
                                                        Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="BtnDeleteStage_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
