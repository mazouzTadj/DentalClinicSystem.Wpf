<Window x:Class="DentalClinic.Features.FinancialDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Fin_Title}" Height="820" Width="1150" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- Top Navigation Bar with Tabs & Actions -->
            <Border DockPanel.Dock="Top" Background="White" Padding="24,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Fin_Title}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnTabIncome" Content="{DynamicResource Fin_TabIncome}" Width="120" Height="34" Margin="0,0,10,0" 
                                Style="{StaticResource PrimaryButtonStyle}" Click="TabButton_Click"/>
                        <Button x:Name="BtnTabExpenses" Content="{DynamicResource Fin_TabExpenses}" Width="120" Height="34" Margin="0,0,10,0" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="TabButton_Click"/>
                        <Button x:Name="BtnTabNetProfit" Content="{DynamicResource Fin_TabNetProfit}" Width="120" Height="34" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="TabButton_Click"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnExport" Content="{DynamicResource Fin_Export}" Width="100" Height="36" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ExportButton_Click" ToolTip="{DynamicResource Fin_ExportTooltip}"/>
                        <Button Content="{DynamicResource Fin_Refresh}" Width="95" Height="36" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">

                    <!-- 1. Income View -->
                    <StackPanel x:Name="IncomeGrid" Visibility="Visible">
                        <!-- Financial Summary Cards -->
                        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="#2E86DE" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_TodayRevenue}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TodayRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisMonth}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MonthRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="#8E44AD" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisYear}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="YearRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_Outstanding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OutstandingText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Charts Section -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Height="230">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_DailyPatientsChart}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <TextBlock x:Name="DailyChartEmptyState" Text="{DynamicResource Fin_NoPatientActivity}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontStyle="Italic" FontSize="12" Visibility="Collapsed"/>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="DailyChartItems">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="34" Margin="3,0" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding ValueText}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border Background="{StaticResource AccentBrush}" Height="{Binding BarHeight}" CornerRadius="4,4,0,0" Margin="3,0" VerticalAlignment="Bottom"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="8.5" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20" Height="230">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_TopTreatments}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="NoTreatmentsText" Text="{DynamicResource Fin_NotEnoughData}" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="TreatmentBarItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentBrush}" Height="14" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Outstanding Balances Grid -->
                        <TextBlock Text="{DynamicResource Fin_OutstandingBalances}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="260">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="OutstandingGrid" Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColPatient}" Binding="{Binding PatientFullName}" Width="1.4*"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColPhone}" Binding="{Binding PhoneNumber}" Width="140"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColLastVisit}" Binding="{Binding LastVisitText}" Width="140"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColAmountOwed}" Binding="{Binding TotalOwedText}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 2. Expenses View -->
                    <StackPanel x:Name="ExpensesGrid" Visibility="Collapsed">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Grid.Column="0" Columns="3" Rows="1" Margin="0,0,16,0">
                                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_TodayExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TodayExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_MonthExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MonthExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="14" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_YearExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="YearExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Button Grid.Column="1" Content="{DynamicResource Fin_AddExpense}" Width="140" Height="45" VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="AddExpenseButton_Click"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource Fin_RecentExpenses}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="400">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>

                            <DataGrid x:Name="ExpensesDataGrid" Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColDate}" Binding="{Binding DateText}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColCategory}" Binding="{Binding Category}" Width="220"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColDescription}" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColAmount}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 3. Net Profit View -->
                    <StackPanel x:Name="NetProfitGrid" Visibility="Collapsed" Margin="0,10,0,0">

                        <!-- Period Overview Card -->
                        <Border Background="White" CornerRadius="20" Padding="30" Width="480" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Fin_PeriodOverview}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Fin_TotalRevenue}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="NetIncomeText" Text="0.00" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="{DynamicResource Fin_TotalExpenses}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="NetExpenseText" Text="0.00" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#E0E0E0" Margin="0,0,0,16"/>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Fin_NetProfit}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="#E8F5E9" Padding="15,8" CornerRadius="8" HorizontalAlignment="Right">
                                        <TextBlock x:Name="NetProfitText" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Filter Controls Bar -->
                        <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <Button x:Name="BtnChartWeekly" Content="{DynamicResource Fin_Last7Days}" Width="110" Height="32" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Click="ChartPeriod_Click"/>
                                    <Button x:Name="BtnChartMonthly" Content="{DynamicResource Fin_Last6Months}" Width="110" Height="32" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="ChartPeriod_Click"/>
                                    <Button x:Name="BtnChartYearly" Content="{DynamicResource Fin_Last5Years}" Width="110" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="ChartPeriod_Click"/>
                                </StackPanel>

                                <Border Width="1" Height="24" Background="#E0E0E0" Margin="0,0,20,0" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Fin_From}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <DatePicker x:Name="DpStartDate" Width="120" Height="32" VerticalAlignment="Center"/>

                                    <TextBlock Text="{DynamicResource Fin_To}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,6,0"/>
                                    <DatePicker x:Name="DpEndDate" Width="120" Height="32" VerticalAlignment="Center"/>

                                    <Button x:Name="BtnApplyDateRange" Content="{DynamicResource Fin_ApplyFilter}" Width="95" Height="32" Margin="12,0,0,0" 
                                            Style="{StaticResource SecondaryButtonStyle}" Click="ApplyDateRange_Click"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <!-- Dual Bar Chart Container -->
                        <Border Background="White" CornerRadius="14" Padding="20" Height="280">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_RevenueVsExpenses}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                                <Grid DockPanel.Dock="Bottom">
                                    <TextBlock x:Name="ProfitChartEmptyState" Text="{DynamicResource Fin_NoDataForPeriod}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontStyle="Italic" FontSize="13" Visibility="Collapsed"/>

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ProfitChartItems" HorizontalAlignment="Center">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="12,0" VerticalAlignment="Bottom">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <Border Background="{StaticResource AccentBrush}" Height="{Binding IncomeBarHeight}" Width="22" CornerRadius="4,4,0,0" Margin="2,0" ToolTip="{Binding IncomeTooltip}" VerticalAlignment="Bottom"/>
                                                            <Border Background="{StaticResource ErrorBrush}" Height="{Binding ExpenseBarHeight}" Width="22" CornerRadius="4,4,0,0" Margin="2,0" ToolTip="{Binding ExpenseTooltip}" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="8" Margin="0,0,0,12" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Fin_LoadingData}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>