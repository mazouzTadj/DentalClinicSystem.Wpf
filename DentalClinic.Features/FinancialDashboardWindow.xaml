<Window x:Class="DentalClinic.Features.FinancialDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Fin_Title}" Height="820" Width="1150" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- Top Navigation Bar with Tabs & Actions -->
            <Border DockPanel.Dock="Top" Background="White" Padding="24,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Fin_Title}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnTabIncome" Content="{DynamicResource Fin_TabIncome}" Width="120" Height="34" Margin="0,0,10,0" 
                                Style="{StaticResource PrimaryButtonStyle}" Click="TabButton_Click"/>
                        <Button x:Name="BtnTabExpenses" Content="{DynamicResource Fin_TabExpenses}" Width="120" Height="34" Margin="0,0,10,0" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="TabButton_Click"/>
                        <Button x:Name="BtnTabNetProfit" Content="{DynamicResource Fin_TabNetProfit}" Width="120" Height="34" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="TabButton_Click"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnExport" Content="{DynamicResource Fin_Export}" Width="100" Height="36" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ExportButton_Click" ToolTip="{DynamicResource Fin_ExportTooltip}"/>
                        <Button Content="{DynamicResource Fin_Refresh}" Width="95" Height="36" 
                                Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">

                    <!-- 1. Income View -->
                    <StackPanel x:Name="IncomeGrid" Visibility="Visible">
                        <!-- Financial Summary Cards -->
                        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="#2E86DE" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_TodayRevenue}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TodayRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TodayRevenueTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisMonth}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MonthRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="MonthRevenueTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="#8E44AD" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisYear}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="YearRevenueText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="YearRevenueTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_Outstanding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OutstandingText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Charts Section -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Height="230">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_DailyPatientsChart}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <TextBlock x:Name="DailyChartEmptyState" Text="{DynamicResource Fin_NoPatientActivity}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontStyle="Italic" FontSize="12" Visibility="Collapsed"/>

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="DailyChartItems">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="34" Margin="3,0" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding ValueText}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border Background="{StaticResource AccentBrush}" Height="{Binding BarHeight}" CornerRadius="4,4,0,0" Margin="3,0" VerticalAlignment="Bottom"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="8.5" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20" Height="230">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource Fin_DoctorStats}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0" Cursor="Hand"
                                                Click="DoctorStatsButton_Click" ToolTip="{DynamicResource Fin_DoctorStatsTooltip}"/>
                                        <Button x:Name="BtnCommissionSettings" Grid.Column="1" Content="{DynamicResource Fin_CommissionSettingsButton}"
                                                FontSize="10.5" Padding="8,3" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                                                Foreground="{StaticResource AccentBrush}" Cursor="Hand" Click="CommissionSettingsButton_Click" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="NoDoctorStatsText" Text="{DynamicResource Fin_NotEnoughData}" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DoctorStatsItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="#F0F0F0">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <TextBlock Text="👑" FontSize="11" Margin="0,0,4,0" Visibility="{Binding CrownVisibility}" ToolTip="{DynamicResource Fin_PrimaryDoctorTooltip}"/>
                                                                    <TextBlock Text="{Binding DoctorName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding IncomeText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding PatientsAndSessionsText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                                                            <Border Background="{StaticResource AccentBrush}" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding CommissionText}" FontSize="10" FontStyle="Italic" Foreground="#E67E22" Visibility="{Binding CommissionVisibility}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Outstanding Balances + Recent Income Grids side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Fin_OutstandingBalances}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{DynamicResource Fin_SelectAll}" Width="72" Height="28" FontSize="11" Margin="4,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAllOutstandingButton_Click"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Fin_ClearSelection}" Width="112" Height="28" FontSize="11" Margin="0,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="ClearOutstandingSelectionButton_Click"/>
                                    <Button Grid.Column="3" Content="{DynamicResource Fin_ZeroSelected}" Width="108" Height="28" FontSize="11" Margin="0,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ZeroSelectedOutstandingButton_Click"/>
                                </Grid>
                                <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <DataGrid x:Name="OutstandingGrid" Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="✓" Width="42">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Checked="OutstandingSelectionCheckBox_Checked"
                                                                  Unchecked="OutstandingSelectionCheckBox_Unchecked"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernCellStyle}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{DynamicResource Fin_ColPatient}" Binding="{Binding PatientFullName}" Width="1.4*" ElementStyle="{StaticResource CellTextStyle}"/>
                                            <DataGridTextColumn Header="{DynamicResource Fin_ColPhone}" Binding="{Binding PhoneNumber}" Width="140" ElementStyle="{StaticResource CellTextStyle}"/>
                                            <DataGridTextColumn Header="{DynamicResource Fin_ColLastVisit}" Binding="{Binding LastVisitText}" Width="140" ElementStyle="{StaticResource CellTextStyle}"/>
                                            <DataGridTextColumn Header="{DynamicResource Fin_ColAmountOwed}" Binding="{Binding TotalOwedText}" Width="140" ElementStyle="{StaticResource CellTextStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>

                            <!-- جدول "المداخيل" الجديد - آخر 50 دفعة، مع بحث باسم المريض للوصول لدفعات أقدم،
                                 وتعديل/حذف كل دفعة (يُحدِّث تلقائياً: المتبقي على الجلسة + عمولة الطبيب لذلك اليوم + كل اللوحة) -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Fin_RecentIncome}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{DynamicResource Fin_SelectAll}" Width="72" Height="28" FontSize="11" Margin="4,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAllIncomeButton_Click"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Fin_DeleteSelected}" Width="108" Height="28" FontSize="11" Margin="0,0,6,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteSelectedIncomeButton_Click"/>
                                    <Border Grid.Column="3" Style="{StaticResource InputContainerStyle}">
                                        <TextBox x:Name="IncomeSearchBox" Style="{StaticResource PlainTextBoxStyle}" FontSize="12" Padding="8,4"
                                                 TextChanged="IncomeSearchBox_TextChanged"/>
                                    </Border>
                                </Grid>
                                <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <TextBlock x:Name="IncomeEmptyText" Text="{DynamicResource Fin_NoIncomeYet}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12" Visibility="Collapsed"/>
                                        <DataGrid x:Name="IncomePaymentsGrid" Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="✓" Width="42">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Checked="IncomeSelectionCheckBox_Checked"
                                                                      Unchecked="IncomeSelectionCheckBox_Unchecked"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellStyle>
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernCellStyle}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                        </Style>
                                                    </DataGridTemplateColumn.CellStyle>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="{DynamicResource Fin_ColPatient}" Binding="{Binding PatientFullName}" Width="1.3*" ElementStyle="{StaticResource CellTextStyle}"/>
                                                <DataGridTextColumn Header="{DynamicResource Fin_ColAmountOwed}" Binding="{Binding AmountText}" Width="120" ElementStyle="{StaticResource CellTextStyle}"/>
                                                <DataGridTextColumn Header="{DynamicResource Fin_ColLastVisit}" Binding="{Binding DateText}" Width="130" ElementStyle="{StaticResource CellTextStyle}"/>
                                                <DataGridTemplateColumn Header="{DynamicResource Fin_ColEdit}" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{DynamicResource Search_EditPatientBtn}" Height="26" Width="55" FontSize="11"
                                                                    Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="EditIncomeButton_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{DynamicResource Fin_ColDelete}" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{DynamicResource Search_DeletePatientBtn}" Height="26" Width="55" FontSize="11"
                                                                    Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="DeleteIncomeButton_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Expenses View -->
                    <StackPanel x:Name="ExpensesGrid" Visibility="Collapsed">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Grid.Column="0" Columns="3" Rows="1" Margin="0,0,16,0">
                                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_TodayExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TodayExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_MonthExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MonthExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="14" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                        <TextBlock Text="{DynamicResource Fin_YearExpense}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="YearExpenseText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Button Grid.Column="1" Content="{DynamicResource Fin_AddExpense}" Width="140" Height="45" VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="AddExpenseButton_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Fin_RecentExpenses}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{DynamicResource Fin_SelectAll}" Width="72" Height="28" FontSize="11" Margin="4,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="SelectAllExpensesButton_Click"/>
                            <Button Grid.Column="2" Content="{DynamicResource Fin_DeleteSelected}" Width="108" Height="28" FontSize="11" Margin="0,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeleteSelectedExpensesButton_Click"/>
                        </Grid>
                        <Border Background="White" CornerRadius="14" ClipToBounds="True" Height="400">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>

                            <DataGrid x:Name="ExpensesDataGrid" Style="{StaticResource ModernDataGridStyle}" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}" RowStyle="{StaticResource ModernRowStyle}" CellStyle="{StaticResource ModernCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Checked="ExpenseSelectionCheckBox_Checked"
                                                          Unchecked="ExpenseSelectionCheckBox_Unchecked"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernCellStyle}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColDate}" Binding="{Binding DateText}" Width="110" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColCategory}" Binding="{Binding Category}" Width="220" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColDescription}" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="{DynamicResource Fin_ColAmount}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTemplateColumn Header="{DynamicResource Fin_ColActions}" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑" ToolTip="{DynamicResource Expense_DeleteTooltip}" Width="30" Height="26"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="13"
                                                        Foreground="{StaticResource ErrorBrush}" Tag="{Binding}" Click="DeleteExpenseButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- 3. Net Profit View -->
                    <StackPanel x:Name="NetProfitGrid" Visibility="Collapsed" Margin="0,10,0,0">

                        <!-- Today/Month/Year Net Profit Cards - نفس تصميم بطاقات تبويب Income بالضبط -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_Today}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TodayNetProfitText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TodayMarginText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TodayNetProfitTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisMonth}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MonthNetProfitText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="MonthMarginText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="MonthNetProfitTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="14" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Height="4" CornerRadius="2" Background="#8E44AD" Margin="0,0,0,12" HorizontalAlignment="Left" Width="36"/>
                                    <TextBlock Text="{DynamicResource Fin_ThisYear}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="YearNetProfitText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="YearMarginText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="YearNetProfitTrendText" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- بند عمولات الأطباء مستقلاً عن باقي المصاريف التشغيلية (أرقام هذا الشهر) -->
                        <Border Background="#FFF8E1" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                            <TextBlock x:Name="CommissionBreakdownText" FontSize="12" Foreground="#7A5B00" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Filter Controls Bar -->
                        <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <Button x:Name="BtnChartWeekly" Content="{DynamicResource Fin_Last7Days}" Width="110" Height="32" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Click="ChartPeriod_Click"/>
                                    <Button x:Name="BtnChartMonthly" Content="{DynamicResource Fin_Last6Months}" Width="110" Height="32" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="ChartPeriod_Click"/>
                                    <Button x:Name="BtnChartYearly" Content="{DynamicResource Fin_Last5Years}" Width="110" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="ChartPeriod_Click"/>
                                </StackPanel>

                                <Border Width="1" Height="24" Background="#E0E0E0" Margin="0,0,20,0" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Fin_From}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <DatePicker x:Name="DpStartDate" Width="120" Height="32" VerticalAlignment="Center"/>

                                    <TextBlock Text="{DynamicResource Fin_To}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,6,0"/>
                                    <DatePicker x:Name="DpEndDate" Width="120" Height="32" VerticalAlignment="Center"/>

                                    <Button x:Name="BtnApplyDateRange" Content="{DynamicResource Fin_ApplyFilter}" Width="95" Height="32" Margin="12,0,0,0" 
                                            Style="{StaticResource SecondaryButtonStyle}" Click="ApplyDateRange_Click"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <!-- Dual Bar Chart Container -->
                        <Border Background="White" CornerRadius="14" Padding="20" Height="280">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Fin_RevenueVsExpenses}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                                <Grid DockPanel.Dock="Bottom">
                                    <TextBlock x:Name="ProfitChartEmptyState" Text="{DynamicResource Fin_NoDataForPeriod}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontStyle="Italic" FontSize="13" Visibility="Collapsed"/>

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ProfitChartItems" HorizontalAlignment="Center">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="12,0" VerticalAlignment="Bottom">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <Border Background="{StaticResource AccentBrush}" Height="{Binding IncomeBarHeight}" Width="22" CornerRadius="4,4,0,0" Margin="2,0" ToolTip="{Binding IncomeTooltip}" VerticalAlignment="Bottom"/>
                                                            <Border Background="{StaticResource ErrorBrush}" Height="{Binding ExpenseBarHeight}" Width="22" CornerRadius="4,4,0,0" Margin="2,0" ToolTip="{Binding ExpenseTooltip}" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="8" Margin="0,0,0,12" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Fin_LoadingData}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>