<Window x:Class="DentalClinic.Features.PrescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Rx_Title}" Height="720" Width="620" MinWidth="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <!-- سطر دواء عادي: اسم الدواء + الجرعة + عدد العلب -->
        <DataTemplate x:Key="MedicationLineTemplate">
            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding MedicationName, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="SemiBold" FontSize="13" BorderThickness="0" Background="Transparent"/>

                    <!-- الجرعة: نفس حجم خط اسم الدواء لكن بدون سماكة (Regular) ولون داكن واضح
                         بدل الرمادي الباهت السابق، لتُقرأ بوضوح عند الكتابة/الطباعة -->
                    <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" FontWeight="Normal" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- عدد العلب: يمكن للمستخدم تعديل القيمة الافتراضية (1BTS) قبل الطباعة، بنفس حجم خط اسم الدواء وبدون سماكة -->
                    <Grid Grid.Row="4" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Rx_BoxCountLabel}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding BoxCount, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" FontWeight="Normal" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Button Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Content="&#10005;"
                            Style="{StaticResource WindowControlButtonStyle}" Width="26" Height="26"
                            VerticalAlignment="Top" Tag="{Binding}" Click="RemoveLineButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- سطر شهادة طبية / عطلة مرضية: فقرة نصية واحدة فقط بنفس خط اسم الدواء، بدون جرعة ولا عدد علب -->
        <DataTemplate x:Key="CertificateLineTemplate">
            <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Rx_CertificateLineLabel}" FontSize="10.5" FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MedicationName, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="SemiBold" FontSize="13" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="&#10005;"
                            Style="{StaticResource WindowControlButtonStyle}" Width="26" Height="26"
                            VerticalAlignment="Top" Tag="{Binding}" Click="RemoveLineButton_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Rx_Title}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Click="CloseButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,10,30,20">
                <StackPanel>

                    <TextBlock x:Name="PatientHeaderText" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,4"/>
                    <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>

                    <!-- إضافة سريعة من قائمة الأدوية الجاهزة -->
                    <TextBlock Text="{DynamicResource Rx_QuickAddLabel}" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InputContainerStyle}">
                            <ComboBox x:Name="PresetBox" BorderThickness="0" Background="Transparent"
                                      Padding="10,8" FontSize="13" VerticalContentAlignment="Center"
                                      DisplayMemberPath="MedicationName"/>
                        </Border>
                        <Button Grid.Column="2" Content="{DynamicResource Rx_AddButton}" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddPresetButton_Click"/>
                    </Grid>

                    <!-- أسطر الوصفة -->
                    <TextBlock Text="{DynamicResource Rx_LinesHeader}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                    <ItemsControl x:Name="LinesItems"/>

                    <Button Content="{DynamicResource Rx_AddCustomLineButton}" Height="36" Margin="0,0,0,18"
                            Style="{StaticResource SecondaryButtonStyle}" Click="AddCustomLineButton_Click"/>

                    <!-- شهادة طبية / عطلة مرضية: إضافة سريعة من قائمة جاهزة، أو فقرة مخصصة حرة -->
                    <TextBlock Text="{DynamicResource Rx_CertificateSectionLabel}" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InputContainerStyle}">
                            <ComboBox x:Name="CertificatePresetBox" BorderThickness="0" Background="Transparent"
                                      Padding="10,8" FontSize="13" VerticalContentAlignment="Center"
                                      DisplayMemberPath="CertificateName"/>
                        </Border>
                        <Button Grid.Column="2" Content="{DynamicResource Rx_AddButton}" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddCertificatePresetButton_Click"/>
                    </Grid>
                    <Button Content="{DynamicResource Rx_AddCustomCertificateButton}" Height="36" Margin="0,0,0,18"
                            Style="{StaticResource SecondaryButtonStyle}" Click="AddCustomCertificateButton_Click"/>

                    <TextBlock Text="{DynamicResource Rx_NotesLabel}" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10">
                        <TextBox x:Name="NotesBox" Style="{StaticResource PlainTextBoxStyle}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50" VerticalContentAlignment="Top"/>
                    </Border>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}"/>
                    <TextBlock Text="Printer" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputContainerStyle}" Margin="0,0,0,10">
                        <ComboBox x:Name="PrinterBox" BorderThickness="0" Background="Transparent"
                                  Padding="10,8" FontSize="13" VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Content="{DynamicResource Rx_GenerateButton}" Height="46" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="GenerateButton_Click"/>
                    <Button Content="{DynamicResource Rx_CloseButton}" Height="38" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
