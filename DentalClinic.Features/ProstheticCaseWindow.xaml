<Window x:Class="DentalClinic.Features.ProstheticCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProsthCase_ListTitle}" Height="560" Width="820" MinWidth="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border CornerRadius="18" Background="{StaticResource CardBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource ProsthCase_ListTitle}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="NewCaseButton" Content="{DynamicResource ProsthCase_NewButton}" Height="30" Padding="10,0"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                            Margin="0,0,8,0" Click="NewCaseButton_Click"/>
                    <Button Content="&#10005;" Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="20,10,20,0" CornerRadius="10" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="CasesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernRowStyle}"
                          CellStyle="{StaticResource ModernCellStyle}"
                          MouseDoubleClick="CasesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ProsthCase_ColCaseNumber}" Binding="{Binding CaseNumber}" Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource ProsthCase_Prosthetist}" Binding="{Binding ProsthetistName}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource ProsthCase_PatientPhone}" Binding="{Binding PatientPhoneNumber}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource ProsthCase_ColStage}" Binding="{Binding StageName}" Width="130"/>
                        <DataGridTextColumn Header="{DynamicResource ProsthCase_ColPrice}" Binding="{Binding PriceText}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="24,0,0,0"/>
            <TextBlock Text="{DynamicResource ProsthCase_DoubleClickHint}" Grid.Row="2" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="0,0,24,0"/>
        </Grid>
    </Border>
</Window>
