<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DentalClinic.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- عميل SQL Server الحديث -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- لتشفير كلمات المرور (Hash) بدلاً من تخزينها كنص صريح -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- سكربت إنشاء البنية الكاملة (13 جدول + FK + Seed لجدول Roles) - يُضمَّن داخل الـ DLL
         نفسه ليتمكن SchemaInitializer من تنفيذه تلقائياً عند أول تشغيل على قاعدة فارغة،
         دون الحاجة لأي ملف خارجي يُنشر بجانب الـ exe -->
    <EmbeddedResource Include="Schema\DentalClinicSchema.sql" />
  </ItemGroup>

</Project>
